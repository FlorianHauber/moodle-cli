    def do_show(self, arg):
        """show <n>  — show an item of the current course."""
        mod = self.get_mod(arg)
        kind = mod["modname"]
        if kind == "assign":
            self.load_assigns(self.course)
            a = next((x for x in self.assigns if x.get("cmid") == mod["id"]), None)
            if a:
