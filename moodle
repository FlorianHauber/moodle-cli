        depth, rows = {}, []
        for i, p in enumerate(posts, 1):
            lvl = depth.get(p.get("parentid"), -1) + 1 if p.get("parentid") else 0
            depth[p["id"]] = lvl
            ind = "    " * min(lvl, 4)
