    # -- assignments -------------------------------------------------------- #
    def load_assigns(self, course=None):
        res = self.need().call("mod_assign_get_assignments", courseids=[course["id"]] if course else [])
        out = []
        for c in res.get("courses", []):
            for a in c.get("assignments", []):
                a["_course"] = c
                out.append(a)
        out.sort(key=lambda a: (a.get("duedate") or 10 ** 12, a.get("name", "")))
        self.assigns = out
        return out

    def find_assign(self, cmid=None, instance=None, course=None):
        for x in self.load_assigns(course):
            if (cmid and x.get("cmid") == cmid) or (instance and x.get("id") == instance):
                return x
        raise MoodleError("assignment not found (maybe not visible to you yet)")

    def get_assign(self, tok):
        if not self.assigns:
            self.load_assigns()
        return self.assigns[parse_nums([tok], len(self.assigns))[0] - 1]

    def assignment_rows(self, items, show_all=False):
        now = time.time()
        rows, hidden = [], 0
        for i, x in enumerate(items, 1):
            due = x.get("duedate") or 0
            if not show_all and due and due < now - 7 * 86400:
                hidden += 1
                continue
            when = due_color(due, fmt_time(due)) if due else dim("no due date          ")
            rows.append((f"[{i:>3}] {when}  {bold(html2text(x['name'], links=False))}  {dim(x['_course'].get('shortname', ''))}  {dim(rel(due))}", x))
        return rows, hidden

    def do_assignments(self, arg):
        """assignments [all] [course]  — list assignments sorted by due date."""
        a = args_of(arg)
        show_all = "all" in a
        rest = " ".join(x for x in a if x != "all")
        course = self.find_course(rest) if rest else None
        items = self.load_assigns(course)
        rows, hidden = self.assignment_rows(items, show_all)
        L = [t for t, _ in rows]
        if hidden:
            L.append(dim(f"\n  ({hidden} older assignments hidden — `assignments all`)"))
        L.append(dim("\n  details: assignment <n>     upload: submit <n> FILE..."))
        page("\n".join(L) if items else "No assignments.")

    def do_assignment(self, arg):
        """assignment <n> [get]  — details, submission status and feedback."""
        a = args_of(arg)
        if not a:
            raise MoodleError("usage: assignment <n> [get]")
        x = self.get_assign(a[0])
        if len(a) > 1 and a[1] == "get":
            got, base = self.get_assignment_files(x)
            return print(green("✓ ") + f"{got} files → {base}")
