        if fb:
            L += ["", bold("Feedback:") + "  " + (html2text(fb.get("gradefordisplay"), links=False) or "-")]
            if fb.get("gradeddate"):
                L.append(dim(f"  graded {fmt_time(fb['gradeddate'])}"))
            for p in fb.get("plugins") or []:
                for ef in p.get("editorfields") or []:
                    if ef.get("text"):
                        L.append(html2text(ef["text"], indent="  │ "))
                for fa in p.get("fileareas") or []:
                    for f in fa.get("files") or []:
                        L.append(f"  feedback file: {f.get('filename')}")
        if hints:
            n = self.assigns.index(x) + 1 if x in self.assigns else "?"
            L.append(dim(f"\n  submit {n} FILE...  |  submit {n} --text  |  assignment {n} get  (download all files)"))
        return L

    def show_assignment(self, x):
        page("\n".join(self.assignment_lines(x)))

    def get_assignment_files(self, x, log=print, show=True):
        base = self.dl_dir() / safe_name(x["_course"].get("shortname")) / "Assignments" / safe_name(x["name"])
        pairs = [(f, base / safe_name(f["filename"], 180)) for f in x.get("introattachments") or []]
        st = self.submission_status(x)
        sub = (st.get("lastattempt") or {}).get("submission") or {}
        for p in sub.get("plugins") or []:
            for fa in p.get("fileareas") or []:
                pairs += [(f, base / "my submission" / safe_name(f["filename"], 180)) for f in fa.get("files") or []]
        for p in (st.get("feedback") or {}).get("plugins") or []:
            for fa in p.get("fileareas") or []:
                pairs += [(f, base / "feedback" / safe_name(f["filename"], 180)) for f in fa.get("files") or []]
        pairs = [(f, d) for f, d in pairs if f.get("fileurl")]
        got, _ = self.fetch_files(pairs, force=True, log=log, show=show)
        return got, base

    def do_submit(self, arg):
        """submit <n> FILE... | submit <n> --text ["text"]  — submit to an assignment."""
        a = args_of(arg)
        if not a:
            raise MoodleError("usage: submit <n> FILE...   or   submit <n> --text [\"text\"]")
        x = self.get_assign(a[0])
        rest = a[1:]
        text = None
        if "--text" in rest:
            i = rest.index("--text")
            text = " ".join(rest[i + 1:]) if rest[i + 1:] else None
            files = rest[:i]
            if text is None:
                text = edit_text()
                if not text:
                    return print("cancelled (empty text).")
        else:
            files = rest
        paths = [Path(os.path.expanduser(f)) for f in files]
        self.submit(x, paths, text)

    def submit(self, x, paths, text):
        for p in paths:
            if not p.is_file():
                raise MoodleError(f"file not found: {p}")
        if not paths and text is None:
            raise MoodleError("give at least one file or --text")

        st = self.submission_status(x)
        last = st.get("lastattempt") or {}
        sub = last.get("submission") or last.get("teamsubmission") or {}
        enabled = {p.get("type") for p in sub.get("plugins") or []}
        if paths and "file" not in enabled:
            raise MoodleError("this assignment does not accept file submissions")
        if text is not None and "onlinetext" not in enabled:
            raise MoodleError("this assignment does not accept online text")
        if not last.get("caneditowner", True) or last.get("locked"):
            raise MoodleError("submissions are locked or closed for you")

        old_files, old_text = [], None
        for p in sub.get("plugins") or []:
            if p.get("type") == "file":
                for fa in p.get("fileareas") or []:
                    old_files += fa.get("files") or []
            if p.get("type") == "onlinetext":
                for ef in p.get("editorfields") or []:
                    old_text = ef.get("text") or None

        print(bold(x["name"]) + dim(f"  ({x['_course'].get('shortname')})"))
        if paths:
            print("Upload: " + ", ".join(f"{p.name} ({human(p.stat().st_size)})" for p in paths))
            if old_files:
                print(yellow("This REPLACES your current files: ") + ", ".join(f["filename"] for f in old_files))
        if text is not None:
            print("Online text: " + (text[:200] + "…" if len(text) > 200 else text))
        if not confirm("Save this submission?"):
            return print("cancelled.")

        plugindata = {}
        if "file" in enabled:
            upload = paths
            tmpdir = None
            if not paths and old_files:  # keep existing files when only the text changes
                tmpdir = Path(tempfile.mkdtemp(prefix="moodle-"))
                upload = []
                for f in old_files:
                    d = tmpdir / safe_name(f["filename"], 180)
                    self.m.download(f["fileurl"], d, show=False)
                    upload.append(d)
            if upload:
                print(dim("uploading…"))
                plugindata["files_filemanager"] = self.m.upload(upload)
            if tmpdir:
                shutil.rmtree(tmpdir, ignore_errors=True)
        if "onlinetext" in enabled:
            body = text_to_html(text) if text is not None else old_text
            if body is not None:
                try:
                    item = self.m.call("core_files_get_unused_draft_itemid").get("itemid", 0)
                except MoodleError:
                    item = 0
                plugindata["onlinetext_editor"] = {"text": body, "format": 1, "itemid": item}

        warnings = self.m.call("mod_assign_save_submission", assignmentid=x["id"], plugindata=plugindata)
        for w in warnings or []:
            err(w.get("message") or w)
        if warnings:
            return
        print(green("✓ saved."))

        if x.get("submissiondrafts"):
            statement = html2text(x.get("submissionstatement"), links=False) if x.get("requiresubmissionstatement") else ""
            if statement:
                print("\n" + statement + "\n")
            q = "Submit for grading now? You usually can't change it afterwards." + (" (accepts the statement above)" if statement else "")
            if confirm(q):
                warnings = self.m.call("mod_assign_submit_for_grading", assignmentid=x["id"],
                                       acceptsubmissionstatement=1 if statement else 0)
                for w in warnings or []:
                    err(w.get("message") or w)
                if not warnings:
                    print(green("✓ submitted for grading."))
            else:
                print(yellow("Left as draft.") + " Submit again later to finalise it.")

    # -- quizzes ------------------------------------------------------------ #
    def load_quizzes(self, course=None):
        res = self.need().call("mod_quiz_get_quizzes_by_courses", courseids=[course["id"]] if course else [])
        byid = {c["id"]: c for c in self.courses()}
        out = []
        for q in res.get("quizzes", []):
            q["_course"] = byid.get(q.get("course")) or {"id": q.get("course"), "shortname": "", "fullname": ""}
            out.append(q)
        out.sort(key=lambda q: (q.get("timeclose") or 10 ** 12, q.get("name", "")))
        self.quizzes = out
        return out

    def find_quiz(self, cmid=None, instance=None, course=None):
        for q in self.load_quizzes(course):
            if (cmid and q.get("coursemodule") == cmid) or (instance and q.get("id") == instance):
                return q
        raise MoodleError("quiz not found (maybe not visible to you yet)")

    def get_quiz(self, tok):
        if not self.quizzes:
            self.load_quizzes()
        if not self.quizzes:
            raise MoodleError("no quizzes")
        return self.quizzes[parse_nums([tok], len(self.quizzes))[0] - 1]

    def quiz_rows(self, items, show_all=False):
        now = time.time()
        rows, hidden = [], 0
        for i, q in enumerate(items, 1):
            close, opn = q.get("timeclose") or 0, q.get("timeopen") or 0
            if not show_all and close and close < now - 7 * 86400:
                hidden += 1
                continue
            when = due_color(close, fmt_time(close)) if close else dim("no closing date      ")
            state = (yellow("not open yet") if opn and opn > now else dim("closed") if close and close < now
                     else green("open"))
            tl = dim(f"  {q['timelimit'] // 60} min") if q.get("timelimit") else ""
            rows.append((f"[{i:>3}] {when}  {bold(html2text(q['name'], links=False))}  {state}{tl}  "
                         f"{dim(q['_course'].get('shortname', ''))}  {dim(rel(close))}", q))
        return rows, hidden

    def do_quizzes(self, arg):
        """quizzes [all] [course]  — list quizzes sorted by closing date."""
        a = args_of(arg)
        show_all = "all" in a
        rest = " ".join(x for x in a if x != "all")
        items = self.load_quizzes(self.find_course(rest) if rest else None)
        rows, hidden = self.quiz_rows(items, show_all)
        L = [t for t, _ in rows]
        if hidden:
            L.append(dim(f"\n  ({hidden} older quizzes hidden — `quizzes all`)"))
        L.append(dim("\n  details: quiz <n>     take it: quiz <n> start     results: quiz <n> review"))
        page("\n".join(L) if items else "No quizzes.")

    def quiz_attempts(self, q, status="all"):
        return self.need().call("mod_quiz_get_user_attempts", quizid=q["id"], status=status,
                                includepreviews=1).get("attempts", [])

    def quiz_grade(self, q, sumgrades):
        if sumgrades is None:
            return "-"
        dp = max(0, int(q.get("decimalpoints") if q.get("decimalpoints") is not None else 2))
        tot, g = q.get("sumgrades") or 0, q.get("grade") or 0
        if not tot:
            return f"{sumgrades:.{dp}f}"
        s = f"{sumgrades:.{dp}f} / {tot:.{dp}f}"
        if g and abs(g - tot) > 1e-9:
            s += f"   (grade {sumgrades / tot * g:.{dp}f} / {g:.{dp}f})"
        return s

    def quiz_lines(self, q, hints=True):
        m = self.need()
        L = [bold(html2text(q["name"], links=False)) + dim(f"   {q['_course'].get('fullname', '')}")]
        for label, key in (("Opens", "timeopen"), ("Closes", "timeclose")):
            if q.get(key):
                L.append(f"{label + ':':10}{due_color(q[key], fmt_time(q[key])) if key == 'timeclose' else fmt_time(q[key])}"
                         f"  {dim(rel(q[key]))}")
        if q.get("timelimit"):
            tl = q["timelimit"]
            L.append(f"{'Time:':10}{tl // 60} min{f' {tl % 60} s' if tl % 60 else ''} (the timer starts when you start an attempt)")
        L.append(f"{'Attempts:':10}{q.get('attempts') or 'unlimited'} allowed"
                 + (f" · grading: {({1: 'highest', 2: 'average', 3: 'first', 4: 'last'}).get(q.get('grademethod'), '?')} attempt"
                    if q.get("grademethod") else ""))
        if q.get("intro"):
            L += ["", html2text(q["intro"])]
        try:
            acc = m.call("mod_quiz_get_quiz_access_information", quizid=q["id"])
        except MoodleError as e:
            acc = {}
            L += ["", dim(f"(access info unavailable: {e})")]
        if acc.get("accessrules"):
            L += [""] + [dim("• ") + html2text(r, links=False) for r in acc["accessrules"]]
        for r in acc.get("preventaccessreasons") or []:
            L.append(yellow("• " + html2text(r, links=False)))
        try:
            attempts = self.quiz_attempts(q)
        except MoodleError as e:
            attempts = []
            L += ["", dim(f"(attempts unavailable: {e})")]
        if attempts:
            L += ["", bold("Your attempts:")]
            for a in attempts:
                st = a.get("state")
                if st == "finished":
                    s = green("finished") + f"  {fmt_time(a.get('timefinish'))}   {self.quiz_grade(q, a.get('sumgrades'))}"
                elif st in ("inprogress", "overdue"):
                    s = yellow("in progress" if st == "inprogress" else "time is up — submit it") + \
                        f"  started {fmt_time(a.get('timestart'))}"
                else:
                    s = dim(st or "?")
                L.append(f"  #{a.get('attempt')}  {s}")
            try:
                bg = m.call("mod_quiz_get_user_best_grade", quizid=q["id"])
                if bg.get("hasgrade"):
                    dp = max(0, int(q.get("decimalpoints") if q.get("decimalpoints") is not None else 2))
                    L.append(f"  {bold('Grade:')} {bg['grade']:.{dp}f} / {q.get('grade') or 0:.{dp}f}")
            except MoodleError:
                pass
        elif not acc.get("preventaccessreasons"):
            L += ["", dim("No attempts yet.")]
        if hints:
            n = self.quizzes.index(q) + 1 if q in self.quizzes else "?"
            L.append(dim(f"\n  quiz {n} start  (start / continue)   |   quiz {n} review [attempt#]"))
        return L

    def show_quiz(self, q):
        page("\n".join(self.quiz_lines(q)))

    def do_quiz(self, arg):
        """quiz <n> [start|review [attempt#]]  — quiz details, take a quiz in the terminal, review results."""
        a = args_of(arg)
        if not a:
            raise MoodleError("usage: quiz <n> [start | review [attempt#]]   (numbers from `quizzes`)")
        q = self.get_quiz(a[0])
        sub = a[1] if len(a) > 1 else ""
        if sub in ("start", "attempt", "continue", "take"):
            return self.run_quiz(q)
        if sub == "review":
            return self.review_quiz(q, a[2] if len(a) > 2 else None)
        if sub:
            raise MoodleError("usage: quiz <n> [start | review [attempt#]]")
        self.show_quiz(q)

    # review ---------------------------------------------------------------- #
    def review_lines(self, q, aid):
        r = self.need().call("mod_quiz_get_attempt_review", attemptid=aid, page=-1)
        at = r.get("attempt") or {}
        L = [bold("Review: " + html2text(q["name"], links=False)) + dim(f"   attempt #{at.get('attempt', '?')}")]
        L.append(f"started {fmt_time(at.get('timestart'))}   finished {fmt_time(at.get('timefinish'))}")
        if at.get("sumgrades") is not None:
            L.append(bold("Marks: ") + self.quiz_grade(q, at.get("sumgrades")))
        for d in r.get("additionaldata") or []:
            txt = html2text(d.get("content"), links=False)
            if txt:
                L.append(f"{html2text(d.get('title'), links=False)}: {txt}")
        for meta in r.get("questions") or []:
            L += [""] + question_lines(meta, parse_question(meta.get("html") or ""))
        return L

    def review_quiz(self, q, which=None):
        done = [a for a in self.quiz_attempts(q) if a.get("state") == "finished"]
        if not done:
            raise MoodleError("no finished attempts to review")
        if which:
            a = next((a for a in done if str(a.get("attempt")) == str(which)), None)
            if not a:
                raise MoodleError(f"no finished attempt #{which} (have: {', '.join(str(a.get('attempt')) for a in done)})")
        else:
            a = done[-1]
        try:
            self.m.call("mod_quiz_view_attempt_review", attemptid=a["id"])
        except MoodleError:
            pass
        page("\n".join(self.review_lines(q, a["id"])))

    # taking a quiz --------------------------------------------------------- #
    QUIZ_RULES = {"quizaccess_openclosedate", "quizaccess_timelimit", "quizaccess_password",
                  "quizaccess_numattempts", "quizaccess_delaybetweenattempts", "quizaccess_ipaddress",
                  "quizaccess_offlineattempts"}

    def quiz_preflight(self, acc, required):
        rules = set(acc.get("activerulenames") or [])
        data = []
        if not required:
            return data
        if "quizaccess_password" in rules:
            pw = getpass.getpass("Quiz password: ")
            data.append({"name": "quizpassword", "value": pw})
        if "quizaccess_offlineattempts" in rules:
            data.append({"name": "confirmdatasaved", "value": "1"})
        return data

    def quiz_input(self, prompt, deadline, pq=None):
        """input() that shows the remaining time and opens images (i1, i2, …)."""
        while True:
            left = time_left(deadline)
            s = input(f"{prompt}{'  ' + left if left else ''} > ")
            st = s.strip().lower()
            if pq and re.fullmatch(r"i\d+", st):
                n = int(st[1:])
                if 1 <= n <= len(pq["images"]):
                    self.open_quiz_image(pq["images"][n - 1])
                else:
                    err(f"no image {st}")
                continue
            return s

    def open_quiz_image(self, url):
        if url.startswith(self.m.url + "/"):
            d = Path(tempfile.mkdtemp(prefix="moodle-quiz-"))
            name = safe_name(urllib.parse.unquote(url.split("?")[0].rsplit("/", 1)[-1]) or "image", 120)
            dest = d / name
            self.m.download(url, dest, show=False)
            target = str(dest)
        else:
            target = url  # foreign host: never send the Moodle token there
        if (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")) and shutil.which("xdg-open"):
            subprocess.Popen(["xdg-open", target], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            print(dim(f"  opened {target}"))
        else:
            print(f"  image: {target}")

    def quiz_ask_field(self, k, f, pq, deadline):
        if f["readonly"]:
            return
        tag = f"  {QUIZ_MARK.format(k)}"
        kind = f["kind"]
        if kind in ("radio", "checkbox", "select"):
            opts = visible_options(f)
            if not opts:
                return
            many = kind == "checkbox"
            keyed = all(o.get("key") for o in opts) and len({o["key"] for o in opts}) == len(opts)
            rng = f"{opts[0]['key']}-{opts[-1]['key']}" if keyed else f"1-{len(opts)}"
            ex = f"{opts[0]['key']} {opts[-1]['key']}" if keyed else f"1 {len(opts)}"
            hint = (f"choose one or more ({rng}, e.g. {ex})" if many else f"choose {rng}") + ", Enter keep, - clear"
            while True:
                s = self.quiz_input(f"{tag} {hint}", deadline, pq).strip()
                if not s:
                    return
                if s == "-":
                    if kind == "radio":
                        clear = next((o for o in f["options"] if o["hidden"]), None)
                        f["value"] = clear["value"] if clear else None
                    elif kind == "checkbox":
                        for o in f["options"]:
                            o["checked"] = False
                    else:
                        ph = select_placeholder(f)
                        if ph is None:
                            err("this field cannot be cleared")
                            continue
                        f["value"] = ph["value"]
                    return
                picks, bad = [], None
                for tok in re.split(r"[\s,;]+", s):
                    if not tok:
                        continue
                    hit = [o for o in opts if o.get("key") and o["key"] == tok.lower()] if keyed else []
                    if len(hit) == 1:
                        picks.append(hit[0])
                        continue
                    if tok.isdigit() and 1 <= int(tok) <= len(opts):
                        picks.append(opts[int(tok) - 1])
                        continue
                    bad = tok
                    break
                if bad is not None:
                    err(f"'{bad}' is not one of {rng}")
                    continue
                if not many and len(picks) != 1:
                    err("choose exactly one")
                    continue
                if kind == "checkbox":
                    for o in f["options"]:
                        o["checked"] = o in picks
                else:
                    f["value"] = picks[0]["value"]
                return
        if kind == "text":
            s = self.quiz_input(f"{tag} type answer (Enter keep, - clear)", deadline, pq)
            if s.strip() == "":
                return
            f["value"] = "" if s.strip() == "-" else "-" if s.strip() == "\\-" else s.strip()
            return
        # textarea (essay)
        s = self.quiz_input(f"{tag} e = write in $EDITOR, or type a one-line answer (Enter keep, - clear)", deadline, pq)
        st = s.strip()
        if not st:
            return
        is_html = f.get("format") == "1"
        if st == "-":
            f["value"] = ""
            return
        if st.lower() == "e":
            cur = html2text(f["value"], links=False) if is_html else f["value"]
            text = edit_text(cur)
            if not text:
                print(dim("  (empty — answer unchanged; type - to clear it)"))
                return
        else:
            text = st
        f["value"] = text_to_html(text) if is_html else text

    @staticmethod
    def quiz_page_data(qs):
        d = {}
        for meta, pq in qs:
            d.update(question_data(pq))
        d["slots"] = ",".join(str(meta["slot"]) for meta, _ in qs)
        return d

    @staticmethod
    def wsdata(d):
        return [{"name": k, "value": "" if v is None else str(v)} for k, v in d.items()]

    def run_quiz(self, q):
        """Start (or continue) an attempt and answer it in the terminal."""
        if not sys.stdin.isatty():
            raise MoodleError("taking a quiz needs an interactive terminal")
        m = self.need()
        name = html2text(q["name"], links=False)
        acc = m.call("mod_quiz_get_quiz_access_information", quizid=q["id"])
        rules = set(acc.get("activerulenames") or [])
        unknown = rules - self.QUIZ_RULES
        open_ = [a for a in self.quiz_attempts(q, "unfinished") if a.get("state") in ("inprogress", "overdue")]
        print(bold(name) + dim(f"  ({q['_course'].get('shortname', '')})"))
        for r in acc.get("accessrules") or []:
            print(dim("• ") + html2text(r, links=False))
        if unknown:
            print(yellow("note: this quiz uses extra access rules (" + ", ".join(sorted(unknown)) +
                         ") — if starting fails, use the browser."))
        if open_:
            att = open_[-1]
            print(yellow(f"You have an unfinished attempt (#{att.get('attempt')}, started {fmt_time(att.get('timestart'))})."))
            if not confirm("Continue it?", default=True):
                return print("ok, nothing changed.")
            ai = m.call("mod_quiz_get_attempt_access_information", quizid=q["id"], attemptid=att["id"])
            pre = self.quiz_preflight(acc, ai.get("ispreflightcheckrequired"))
        else:
            if acc.get("preventaccessreasons"):
                raise MoodleError("you cannot attempt this quiz now:\n  " +
                                  "\n  ".join(html2text(r, links=False) for r in acc["preventaccessreasons"]))
            ai = m.call("mod_quiz_get_attempt_access_information", quizid=q["id"])
            if ai.get("preventnewattemptreasons"):
                raise MoodleError("no new attempt possible:\n  " +
                                  "\n  ".join(html2text(r, links=False) for r in ai["preventnewattemptreasons"]))
            done = len(self.quiz_attempts(q, "finished"))
            allowed = q.get("attempts") or 0
            print(f"This will be attempt {done + 1}" + (f" of {allowed}." if allowed else "."))
            if q.get("timelimit"):
                print(yellow(f"Time limit {q['timelimit'] // 60} min {q['timelimit'] % 60:02d} s — the timer starts "
                             "as soon as you start, and the quiz is submitted automatically when time is up."))
            pre = self.quiz_preflight(acc, ai.get("ispreflightcheckrequired"))
            if not confirm("Start the attempt now?"):
                return print("cancelled.")
            res = m.call("mod_quiz_start_attempt", quizid=q["id"], preflightdata=pre, forcenew=0)
            for w in res.get("warnings") or []:
                err(w.get("message") or w)
            att = res.get("attempt")
            if not att:
                raise MoodleError("the attempt could not be started")
            try:
                m.call("mod_quiz_view_quiz", quizid=q["id"])
            except MoodleError:
                pass
        self.quiz_attempt_loop(q, att, pre)

    def quiz_attempt_loop(self, q, att, pre):
        m = self.m
        aid = att["id"]
        name = html2text(q["name"], links=False)
        ai = m.call("mod_quiz_get_attempt_access_information", quizid=q["id"], attemptid=aid)
        deadline = ai.get("endtime") or 0
        layout = [x for x in (att.get("layout") or "").split(",") if x != ""]
        npages = max(1, layout.count("0"))
        nav = q.get("navmethod")  # "free" | "seq" | None (not told)
        page_ = att.get("currentpage") or 0
        maxpage = page_
        pending = {}
        state = att.get("state")
        finished_state = None
        use_alarm = bool(deadline) and hasattr(signal, "SIGALRM")
        old_handler = None

        def on_alarm(signum, frame):
            raise QuizTimeUp()

        if use_alarm:
            old_handler = signal.signal(signal.SIGALRM, on_alarm)
            # submit a few seconds before the deadline (the server's clock decides)
            signal.alarm(max(1, int(deadline - time.time()) - 5))

        def stop_alarm():
            if use_alarm:
                signal.alarm(0)

        def finish(timeup=False):
            stop_alarm()
            res = m.call("mod_quiz_process_attempt", attemptid=aid, data=self.wsdata(pending if timeup else {}),
                         finishattempt=1, timeup=int(timeup), preflightdata=pre)
            for w in res.get("warnings") or []:
                err(w.get("message") or w)
            return res.get("state")

        def can_jump(p):
            return nav == "free" or (nav != "seq" and p <= maxpage)

        try:
            if state == "overdue":
                page_ = None
            while True:
                if page_ is None:  # summary page
                    act = self.quiz_summary(q, aid, pre, deadline, can_jump, overdue=(state == "overdue"))
                    if act == "finish":
                        finished_state = finish()
                        break
                    if act == "exit":
                        stop_alarm()
                        print(yellow("Left the quiz. Your attempt is still open") +
                              (yellow(" and the timer keeps running") if deadline else "") +
                              yellow(f" — continue with: quiz {self.quizzes.index(q) + 1 if q in self.quizzes else '<n>'} start"))
                        return
                    page_ = act
                    continue
                try:
                    d = m.call("mod_quiz_get_attempt_data", attemptid=aid, page=page_, preflightdata=pre)
                except MoodleError as e:
                    err(e)
                    page_ = None
                    continue
                state = (d.get("attempt") or {}).get("state", state)
                if state == "overdue":
                    print(red("Time is up — you can only submit now."))
                    page_ = None
                    continue
                if state != "inprogress":
                    finished_state = state
                    break
                maxpage = max(maxpage, page_)
                try:
                    m.call("mod_quiz_view_attempt", attemptid=aid, page=page_, preflightdata=pre)
                except MoodleError:
                    pass
                qs = [(meta, parse_question(meta.get("html") or "")) for meta in d.get("questions") or []]
                pending = self.quiz_page_data(qs)
                print()
                print(bold(f"{name} · page {page_ + 1}/{npages}") + ("   " + time_left(deadline) if deadline else ""))
                for msg in d.get("messages") or []:
                    print(dim(html2text(msg, links=False)))
                print(dim("Enter keeps the shown answer · Ctrl-C = menu (summary / leave)"))
                interrupted = False
                try:
                    for meta, pq in qs:
                        print("\n".join(question_lines(meta, pq)))
                        if meta.get("blockedbyprevious") or meta.get("type") == "description":
                            continue
                        if not pq["fields"] and meta.get("type") != "description":
                            print(yellow("  This question type can't be answered in the terminal — open it in the browser:\n  "
                                         f"{m.url}/mod/quiz/attempt.php?attempt={aid}&cmid={q.get('coursemodule')}&page={page_}"))
                        for k, f in enumerate(pq["fields"], 1):
                            self.quiz_ask_field(k, f, pq, deadline)
                            pending = self.quiz_page_data(qs)
                except (KeyboardInterrupt, EOFError):
                    interrupted = True
                    print()
                pending = self.quiz_page_data(qs)
                res = m.call("mod_quiz_process_attempt", attemptid=aid, data=self.wsdata(pending),
                             finishattempt=0, timeup=0, preflightdata=pre)
                for w in res.get("warnings") or []:
                    err(w.get("message") or w)
                state = res.get("state") or state
                print(green("✓ answers saved"))
                if state == "overdue":
                    print(red("Time is up — you can only submit now."))
                    page_ = None
                    continue
                if state != "inprogress":
                    finished_state = state
                    break
                nextp = d.get("nextpage", -1)
                if not interrupted:
                    page_ = None if nextp in (-1, None) else nextp
                    continue
                opts = ["[Enter] next page" if nextp not in (-1, None) else "[Enter] summary", "r redo this page"]
                if page_ > 0 and nav != "seq":
                    opts.append("b back")
                opts += ["s summary", "x leave (attempt stays open)"]
                while True:
                    c = self.quiz_input("  " + " · ".join(opts), deadline).strip().lower()
                    if c == "":
                        page_ = None if nextp in (-1, None) else nextp
                    elif c == "r":
                        pass
                    elif c == "b" and page_ > 0 and nav != "seq":
                        page_ -= 1
                    elif c == "s":
                        page_ = None
                    elif c == "x":
                        stop_alarm()
                        print(yellow("Left the quiz. Your attempt is still open") +
                              (yellow(" and the timer keeps running.") if deadline else "."))
                        return
                    else:
                        continue
                    break
        except QuizTimeUp:
            print()
            print(red(bold("Time is up — submitting your attempt…")))
            finished_state = finish(timeup=True)
        except (KeyboardInterrupt, EOFError):
            stop_alarm()
            print(yellow("\nLeft the quiz. Your attempt is still open") +
                  (yellow(" and the timer keeps running.") if deadline else "."))
            return
        finally:
            stop_alarm()
            if use_alarm:
                signal.signal(signal.SIGALRM, old_handler or signal.SIG_DFL)
        self.quiz_done(q, aid, finished_state)

    def quiz_summary(self, q, aid, pre, deadline, can_jump, overdue=False):
        m = self.m
        s = m.call("mod_quiz_get_attempt_summary", attemptid=aid, preflightdata=pre)
        try:
            m.call("mod_quiz_view_attempt_summary", attemptid=aid, preflightdata=pre)
        except MoodleError:
            pass
        qs = [x for x in s.get("questions") or [] if x.get("type") != "description"]
        print()
        print(bold("Summary of your attempt") + ("   " + time_left(deadline) if deadline else ""))
        todo = 0
        for x in qs:
            num = x.get("questionnumber") or x.get("number")
            st = x.get("status") or x.get("state") or ""
            if x.get("state") in ("todo", "invalid"):
                todo += 1
                st = yellow(st)
            print(f"  {num!s:>4}  {st}" + (yellow("  ⚑") if x.get("flagged") else ""))
        if todo:
            print(yellow(f"  {todo} question(s) not answered yet."))
        jumpable = {str(x.get("questionnumber") or x.get("number")): x.get("page") for x in qs
                    if not overdue and x.get("page") is not None and can_jump(x["page"])}
        opts = ["f submit all and finish"]
        if jumpable:
            opts.append("<number> go to question")
        opts.append("x leave (attempt stays open)")
        while True:
            c = self.quiz_input("  " + " · ".join(opts), deadline).strip().lower()
            if c == "f":
                if confirm("Submit all and finish? You can't change your answers afterwards."):
                    return "finish"
                continue
            if c == "x":
                return "exit"
            if c in jumpable:
                return jumpable[c]
            if c:
                err("unknown choice")

    def quiz_done(self, q, aid, state):
        if state == "finished":
            print(green(bold("✓ Attempt submitted.")))
        elif state == "abandoned":
            print(red("The attempt was closed without being submitted in time (abandoned)."))
            return
        else:
            print(yellow(f"Attempt state: {state}"))
            return
        try:
            lines = self.review_lines(q, aid)
        except MoodleError as e:
            return print(dim(f"Review not available (yet): {str(e).split(chr(10))[0]}"))
        at_marks = next((l for l in lines if strip_ansi(l).startswith("Marks: ")), None)
        if at_marks:
            print(at_marks)
        if confirm("Show the review (your answers, feedback)?", default=True):
            page("\n".join(lines))

