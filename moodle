    # -- downloading -------------------------------------------------------- #
    def mod_files(self, mod, course):
        """[(fileinfo, destination path)] for a module."""
        out = []
        base = self.dl_dir() / safe_name(course["shortname"]) / safe_name(mod.get("_section", ""))
        if mod["modname"] in ("url", "label", "forum"):
            return out
        files = [f for f in mod.get("contents") or [] if f.get("type") == "file" and f.get("fileurl")]
        if mod["modname"] in ("page", "book") or (mod["modname"] != "resource" and len(files) > 1) or mod["modname"] == "folder":
            base = base / safe_name(mod["name"])
        for f in files:
            sub = [safe_name(p) for p in (f.get("filepath") or "/").strip("/").split("/") if p]
            out.append((f, base.joinpath(*sub, safe_name(f["filename"], 180))))
        return out

    @staticmethod
    def up_to_date(f, dest):
        t = f.get("timemodified") or 0
        return dest.exists() and dest.stat().st_size == (f.get("filesize") or -1) and \
            (not t or abs(dest.stat().st_mtime - t) < 2)

    def fetch_files(self, pairs, force=False, log=print, show=True):
        got = skipped = 0
        for f, dest in pairs:
            if not force and self.up_to_date(f, dest):
                skipped += 1
                continue
            shown = dest.relative_to(self.dl_dir()) if self.dl_dir() in dest.parents else dest
            log(f"  ↓ {shown}  {dim(human(f.get('filesize')))}")
            try:
                self.m.download(f["fileurl"], dest, mtime=f.get("timemodified") or None, show=show)
                got += 1
            except MoodleError as e:
                log(red(f"  {f['filename']}: {e}"))
        return got, skipped

    def do_get(self, arg):
        """get <n...|all>  — download the files of items, e.g. `get 2 4-6`."""
        mods = self.ensure_modules()
        nums = parse_nums(args_of(arg) or ["?"], len(mods))
        pairs = []
        for n in nums:
            pairs += self.mod_files(mods[n - 1], self.course)
        if not pairs:
            return print("nothing to download (no files in those items).")
        got, skipped = self.fetch_files(pairs, force=len(nums) == 1)
        print(green("✓ ") + f"{got} downloaded, {skipped} already up to date  →  {self.dl_dir() / safe_name(self.course['shortname'])}")

    def sync_course(self, c, log=print, show=True):
        _, mods = self.course_modules(c)
        pairs = []
        for mod in mods:
            if mod["modname"] in ("resource", "folder"):
                pairs += self.mod_files(mod, c)
        return self.fetch_files(pairs, log=log, show=show)

    def do_sync(self, arg):
        """sync [course|all|everything]  — download new/changed files. all = every course that is not past."""
        a = arg.strip()
        if a in ("all", "everything"):
            targets = [c for c in self.courses() if a == "everything" or self.course_group(c) < 2]
        else:
            targets = [self.find_course(a)]
        total = [0, 0]
        for c in targets:
            print(bold(c["shortname"]))
            got, skipped = self.sync_course(c)
            total[0] += got
            total[1] += skipped
        print(green("✓ ") + f"{total[0]} downloaded, {total[1]} already up to date  →  {self.dl_dir()}")

    def do_fetch(self, arg):
        """fetch <url> [dest]  — download any Moodle file link with your token."""
        a = args_of(arg)
        if not a:
            raise MoodleError("usage: fetch <url> [destination]")
        url = a[0]
        name = urllib.parse.unquote(url.split("?")[0].rstrip("/").split("/")[-1]) or "download"
        dest = Path(os.path.expanduser(a[1])) if len(a) > 1 else self.dl_dir() / "downloads" / safe_name(name, 180)
        if dest.is_dir():
            dest = dest / safe_name(name, 180)
        n = self.need().download(url, dest)
        print(green("✓ ") + f"{dest}  {dim(human(n))}")

    # -- deadlines ---------------------------------------------------------- #
    def todo_rows(self):
        now = int(time.time())
        res = self.need().call("core_calendar_get_action_events_by_timesort",
                               timesortfrom=now - 14 * 86400, limitnum=50)
        evs = sorted(res.get("events", []), key=lambda e: e.get("timesort") or e.get("timestart") or 0)
        rows, last_day = [], None
        for e in evs:
            ts = e.get("timesort") or e.get("timestart")
            day = "Overdue" if ts < now else datetime.fromtimestamp(ts).strftime("%A, %d %B")
            if day != last_day:
                if rows:
                    rows.append(("", None))
                rows.append((red(bold(day)) if day == "Overdue" else bold(day), None))
                last_day = day
            course = (e.get("course") or {}).get("shortname", "")
            action = (e.get("action") or {}).get("name", "")
            rows.append((f"  {due_color(ts, datetime.fromtimestamp(ts).strftime('%H:%M'))}  {html2text(e.get('name'), links=False)}"
                         f"  {dim(course)}  {dim('· ' + action if action else '')}  {dim(rel(ts))}", e))
        return rows

