class CoursesView(View):
    hint = "Enter open · s sync files · m move to group · / filter"

    def __init__(self, app):
        super().__init__(app, "Courses")

    def build(self):
        self.sh.courses(refresh=self.loaded)
        return self.build_rows()

    def build_rows(self):
        rows = []
        for title, items in self.sh.course_groups():
            if not items:
                continue
            if rows:
                rows.append(Row("", sel=False))
            rows.append(Row(cyan(bold(f"{title} ({len(items)})")), sel=False))
            rows += [Row(self.sh.course_line(i, c), c) for i, c in items]
        return rows or text_rows("You are not enrolled in any courses.")

    def enter(self, c):
        self.app.push(CourseView(self.app, c))

    def key(self, k, c):
        if k == "s" and c:
            self.app.sync_course(c)
            return True
        if k == "m" and c:
            ans = self.app.prompt("move to  [c]urrent  [h]idden  [p]ast  [a]uto: ")
            target = {"c": "current", "h": "hidden", "p": "past", "a": "auto"}.get((ans or "").strip()[:1].lower())
            if target:
                self.sh.set_group([c], target)
                self.all_rows = self.build_rows()
                self.apply_filter()
                for i, r in enumerate(self.rows):
                    if r.data is c:
                        self.sel = i
                        self.show_sel()
                self.app.msg = green(f"✓ moved to {target}")
            return True


class CourseView(View):
    hint = "Enter open · d download · s sync course · c done ✓ · o open file"

    def __init__(self, app, c):
        super().__init__(app, c.get("shortname") or c.get("fullname"))
        self.c = c

    def build(self):
        sections, self.mods = self.sh.course_modules(self.c)
        if self.sh.cfg.get("last_course") != self.c["id"]:
            self.sh.cfg["last_course"] = self.c["id"]
            save_config(self.sh.cfg)
        return rows_from(self.sh.course_rows(sections, header_course=self.c))

    def enter(self, mod):
        app, kind = self.app, mod["modname"]
        name = html2text(mod.get("name"), links=False)
        if mod.get("uservisible", True):
            if kind in ("resource", "folder"):
                return app.push(FilesView(app, mod, self.c))
            if kind == "assign":
                return app.push(AssignmentView(app, self.sh.find_assign(cmid=mod["id"], course=self.c)))
            if kind == "forum":
                return app.push(ForumView(app, mod))
            if kind == "quiz":
                return app.push(QuizView(app, self.sh.find_quiz(cmid=mod["id"], course=self.c)))
        app.push(TextView(app, name, lambda: self.sh.mod_lines(mod, hints=False)))

    def key(self, k, mod):
        if k == "s":
            self.app.sync_course(self.c)
        elif mod is None:
            return False
        elif k == "d":
            pairs = self.sh.mod_files(mod, self.c)
            if not pairs:
                self.app.msg = yellow("no files in this item")
            else:
                got, _ = self.sh.fetch_files(pairs, force=True, log=self.app.status, show=False)
                self.app.msg = green(f"✓ {got} file(s) → {pairs[0][1].parent}")
        elif k == "o":
            pairs = self.sh.mod_files(mod, self.c)
            if len(pairs) != 1:
                if pairs:
                    self.app.push(FilesView(self.app, mod, self.c))
                else:
                    self.app.msg = yellow("nothing to open")
            else:
                self.app.open_file(*pairs[0])
        elif k == "c":
            new = self.sh.toggle_done(mod)
            self.rows[self.sel].text = self.sh.mod_line(int(re.search(r"\[\s*(\d+)\]", strip_ansi(self.rows[self.sel].text)).group(1)), mod)
            self.app.msg = green("marked done ✓") if new else "marked not done"
        else:
            return False
        return True


