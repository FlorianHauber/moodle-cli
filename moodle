VOID_TAGS = {"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "param",
             "source", "track", "wbr"}
QUIZ_HIDE = {"accesshide", "sr-only", "visually-hidden", "questionflag", "im-controls",
             "qtype_multichoice_clearchoice", "questioncorrectnessicon", "answernumber-hidden"}
QUIZ_MARK = "⟨{}⟩"


class Node:
    __slots__ = ("tag", "attrs", "children", "parent")

    def __init__(self, tag, attrs=None, parent=None):
        self.tag, self.attrs, self.children, self.parent = tag, dict(attrs or []), [], parent

    @property
    def classes(self):
        return set((self.attrs.get("class") or "").split())

    def iter(self):
        for c in self.children:
            if isinstance(c, Node):
                yield c
                yield from c.iter()

    def find(self, pred):
        return next((n for n in self.iter() if pred(n)), None)

    def ancestor(self, pred, levels=50):
        n = self.parent
        while n is not None and levels > 0:
            if pred(n):
                return n
            n, levels = n.parent, levels - 1
        return None

    def contains(self, other):
        n = other
        while n is not None:
            if n is self:
                return True
            n = n.parent
        return False

    def text(self):
        return "".join(c if isinstance(c, str) else c.text() for c in self.children)


class _DOM(HTMLParser):
    """Tiny tolerant HTML -> tree parser (enough for Moodle question HTML)."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.root = Node("#root")
        self.cur = self.root

    def handle_starttag(self, tag, attrs):
        n = Node(tag, attrs, self.cur)
        self.cur.children.append(n)
        if tag not in VOID_TAGS:
            self.cur = n

    def handle_startendtag(self, tag, attrs):
        self.cur.children.append(Node(tag, attrs, self.cur))

    def handle_endtag(self, tag):
        n = self.cur
        while n is not self.root and n.tag != tag:
            n = n.parent
        if n is not self.root:
            self.cur = n.parent

    def handle_data(self, data):
        self.cur.children.append(data)


def parse_dom(src):
    d = _DOM()
    try:
        d.feed(src or "")
        d.close()
    except Exception:
        pass
    return d.root


def serialize(node, tf):
    """Node children -> HTML. tf(node) may return a replacement string (or None to keep)."""
    import html as _h
    out = []

    def walk(n):
        for c in n.children:
            if isinstance(c, str):
                out.append(_h.escape(c, quote=False))
                continue
            r = tf(c)
            if r is not None:
                out.append(r)
                continue
            attrs = "".join(f' {k}="{_h.escape(v, quote=True)}"' if v is not None else f" {k}"
                            for k, v in c.attrs.items())
            out.append(f"<{c.tag}{attrs}>")
            if c.tag not in VOID_TAGS:
                walk(c)
                out.append(f"</{c.tag}>")
    walk(node)
    return "".join(out)


def _input_type(n):
    return (n.attrs.get("type") or "text").lower() if n.tag == "input" else n.tag


def _result_of(n):
    """correct / incorrect / partiallycorrect class on the control or its row (review pages)."""
    for x in (n, n.parent, n.parent.parent if n.parent else None):
        if x is None:
            continue
        c = x.classes
        for r in ("partiallycorrect", "incorrect", "correct"):
            if r in c:
                return r
    return None


def parse_question(src):
    """Parse one question's HTML (from mod_quiz_get_attempt_data / _review).

    Returns {text, fields, hidden, images, notes}:
      fields  — answer controls the user can fill in (radio/checkbox/select/text/textarea)
      hidden  — [(name, value)] hidden inputs (sequencecheck etc.) that must be sent back
    """
    import html as _h
    root = parse_dom(src)
    que = root.find(lambda n: "que" in n.classes) or root
    content = que.find(lambda n: "content" in n.classes) or que
    byid, labfor = {}, {}
    for n in root.iter():
        if n.attrs.get("id"):
            byid.setdefault(n.attrs["id"], n)
        if n.tag == "label" and n.attrs.get("for"):
            labfor.setdefault(n.attrs["for"], n)

    hidden, fields, notes = [], [], []
    drop, marks, label_nodes = set(), {}, []
    radios = {}
    prev = None
    for n in que.iter():
        if n.tag not in ("input", "select", "textarea"):
            continue
        name = n.attrs.get("name")
        t = _input_type(n)
        if not name or t in ("submit", "button", "image", "reset"):
            continue
        if t == "hidden":
            hidden.append((name, n.attrs.get("value") or ""))
            continue
        if name.endswith(":flagged"):  # the "flag question" checkbox
            if "checked" in n.attrs:
                hidden.append((name, n.attrs.get("value") or "1"))
            continue
        ro = "disabled" in n.attrs or "readonly" in n.attrs
        if t == "file":
            notes.append("file uploads are not supported here — use the browser for this question")
            continue
        if t in ("radio", "checkbox"):
            lid = n.attrs.get("aria-labelledby")
            lab = byid.get(lid) if lid else None
            if lab is None and n.attrs.get("id"):
                lab = labfor.get(n.attrs["id"])
            if lab is not None:
                drop.add(id(lab))
            num = lab.find(lambda x: "answernumber" in x.classes) if lab is not None else None
            key = re.sub(r"[\s.)]+$", "", num.text().strip()).lower() if num is not None else ""
            clear = n.attrs.get("value") == "-1" or n.ancestor(lambda x: "qtype_multichoice_clearchoice" in x.classes) is not None
            opt = {"name": name, "value": n.attrs.get("value", "on"), "label": "", "key": key,
                   "checked": "checked" in n.attrs, "hidden": clear, "result": _result_of(n)}
            label_nodes.append((opt, lab, n))
            if t == "radio":
                f = radios.get(name)
                if f is None:
                    f = radios[name] = {"kind": "radio", "name": name, "label": "", "options": [],
                                        "value": None, "readonly": ro, "result": None}
                    fields.append(f)
                    marks[id(n)] = len(fields)
                f["options"].append(opt)
                if opt["checked"] and not clear:
                    f["value"] = opt["value"]
            else:
                if fields and fields[-1]["kind"] == "checkbox" and prev == "checkbox":
                    f = fields[-1]
                else:
                    f = {"kind": "checkbox", "name": name, "label": "", "options": [], "readonly": ro, "result": None}
                    fields.append(f)
                    marks[id(n)] = len(fields)
                f["options"].append(opt)
            f["readonly"] = f["readonly"] or ro
            prev = t
            continue
        kind = "select" if t == "select" else "textarea" if t == "textarea" else "text"
        f = {"kind": kind, "name": name, "label": "", "readonly": ro, "result": _result_of(n), "_node": n}
        if kind == "select":
            opts = [{"value": o.attrs["value"] if "value" in o.attrs else o.text().strip(),
                     "label": re.sub(r"\s+", " ", o.text()).strip(),
                     "selected": "selected" in o.attrs} for o in n.iter() if o.tag == "option"]
            f["options"] = opts
            sel = next((o for o in opts if o["selected"]), opts[0] if opts else None)
            f["value"] = sel["value"] if sel else ""
        elif kind == "textarea":
            f["value"] = n.text()
            if f["value"].startswith("\n"):  # browsers drop one leading newline
                f["value"] = f["value"][1:]
        else:
            f["value"] = n.attrs.get("value") or ""
        fields.append(f)
        marks[id(n)] = len(fields)
        prev = t

    images = []

    def tf(n):
        if n.tag in ("script", "style", "noscript", "button"):
            return ""
        if n.classes & QUIZ_HIDE or id(n) in drop:
            return ""
        if n.tag == "img":
            if n.classes & {"icon", "questioncorrectnessicon", "questionflagimage"}:
                return ""
            src_ = n.attrs.get("src") or ""
            if not src_:
                return ""
            images.append(src_)
            alt = (n.attrs.get("alt") or "").strip()
            return _h.escape(f" [image i{len(images)}{': ' + alt if alt else ''}] ", quote=False)
        if n.tag in ("input", "select", "textarea"):
            if _input_type(n) in ("hidden", "radio", "checkbox", "submit", "button", "image", "reset"):
                return ""
            k = marks.get(id(n))
            return f" {QUIZ_MARK.format(k)} " if k else ""
        return None

    outcome = content.find(lambda n: "outcome" in n.classes)
    if outcome is not None:
        drop.add(id(outcome))
    text = html2text(serialize(content, tf))
    feedback = ""
    if outcome is not None:
        drop.discard(id(outcome))
        feedback = html2text(serialize(outcome, tf))

    def tf_label(n):
        return "" if "answernumber" in n.classes else tf(n)

    for opt, lab, inp in label_nodes:
        if lab is not None:
            txt = html2text(serialize(lab, tf_label), links=False)
            opt["label"] = "\n".join(l for l in txt.split("\n") if l.strip())
        else:
            opt["label"] = inp.attrs.get("aria-label") or ("?" if opt["hidden"] else opt["value"])
    for f in fields:
        n = f.pop("_node", None)
        if n is None:
            continue
        tr = n.ancestor(lambda x: x.tag == "tr", levels=6)
        if tr is not None:
            parts = [html2text(serialize(td, tf), links=False).strip() for td in tr.children
                     if isinstance(td, Node) and td.tag in ("td", "th") and not td.contains(n)]
            f["label"] = " ".join(p for p in parts if p)
        if not f["label"] and n.attrs.get("id") in labfor:
            f["label"] = re.sub(r"\s+", " ", labfor[n.attrs["id"]].text()).strip()
    hd = dict(hidden)
    for f in fields:
        if f["kind"] == "textarea":
            f["format"] = hd.get(f["name"] + "format")
    if any(k.endswith("_attachments") for k, _ in hidden):
        notes.append("file attachments for this question can only be uploaded in the browser")
    return {"text": text, "feedback": feedback, "fields": fields, "hidden": hidden, "images": images, "notes": notes}


def question_data(pq):
    """The form data a browser would POST for this question (hidden fields + current answers)."""
    d = dict(pq["hidden"])
    for f in pq["fields"]:
        if f["readonly"]:
            continue
        if f["kind"] == "radio":
            if f["value"] is not None:
                d[f["name"]] = f["value"]
        elif f["kind"] == "checkbox":
            for o in f["options"]:
                if o["checked"]:
                    d[o["name"]] = o["value"]
                elif d.get(o["name"]) == o["value"]:
                    d.pop(o["name"])
        else:
            d[f["name"]] = f["value"]
    return d


def select_placeholder(f):
    o = f["options"][0] if f.get("options") else None
    return o if o is not None and o["value"] in ("", "0") else None


def visible_options(f):
    if f["kind"] == "select":
        ph = select_placeholder(f)
        return [o for o in f["options"] if o is not ph]
    return [o for o in f["options"] if not o["hidden"]]


def field_lines(k, f):
    titles = {"radio": "Choose one", "checkbox": "Choose one or more", "select": "Choose",
              "text": "Answer", "textarea": "Answer"}
    label = (f["label"] or titles[f["kind"]]).split("\n")
    L = [cyan(QUIZ_MARK.format(k)) + " " + bold(label[0])] + ["    " + x for x in label[1:]]
    res_mark = {"correct": green(" ✓"), "incorrect": red(" ✗"), "partiallycorrect": yellow(" ~")}
    if f["kind"] in ("radio", "checkbox", "select"):
        opts = visible_options(f)
        keyed = all(o.get("key") for o in opts) and len({o["key"] for o in opts}) == len(opts)
        for i, o in enumerate(opts, 1):
            if f["kind"] == "radio":
                on = f["value"] == o["value"]
                mark = "●" if on else "○"
            elif f["kind"] == "checkbox":
                on = o["checked"]
                mark = "☑" if on else "☐"
            else:
                on = f["value"] == o["value"]
                mark = "●" if on else "○"
            lines = (o["label"] or o["value"]).split("\n")
            res = res_mark.get(o.get("result") or (f.get("result") if on else None), "") if on else ""
            mk = green(mark) if on else dim(mark)
            num = o["key"] if keyed else str(i)
            L.append(f"    {mk} {num:>2}) {lines[0]}{res}")
            L += ["          " + x for x in lines[1:]]
    elif f["kind"] == "text":
        L.append("    " + (f["value"] if f["value"] else dim("(empty)")) + res_mark.get(f.get("result"), ""))
    else:
        txt = html2text(f["value"], links=False) if f.get("format") == "1" else f["value"]
        lines = txt.strip().split("\n") if txt.strip() else []
        L += ["    │ " + x for x in lines[:12]] or ["    " + dim("(empty)")]
        if len(lines) > 12:
            L.append(dim(f"    │ … ({len(lines) - 12} more lines)"))
    return L


def question_lines(meta, pq):
    num = meta.get("questionnumber") or meta.get("number")
    title = f"Question {num}" if num not in (None, "", "i") else "Information"
    extra = []
    if meta.get("status"):
        extra.append(meta["status"])
    if meta.get("mark") not in (None, ""):
        extra.append(f"mark {meta['mark']} / {meta.get('maxmark')}")
    elif meta.get("maxmark") not in (None, "") and meta.get("type") != "description":
        mm = meta["maxmark"]
        extra.append(f"{mm:g} point{'s' if mm != 1 else ''}" if isinstance(mm, (int, float)) else f"{mm} points")
    if meta.get("flagged"):
        extra.append("⚑ flagged")
    L = [cyan("━" * min(width(), 60)), bold(title) + dim("   " + " · ".join(extra) if extra else "")]
    if meta.get("blockedbyprevious"):
        L.append(yellow("(blocked until you answer the previous question)"))
    if pq["text"]:
        L += ["", pq["text"]]
    if pq["images"]:
        L.append(dim("  " + str(len(pq["images"])) + " image(s) — type i1, i2, … at an answer prompt to open them"))
    for k, f in enumerate(pq["fields"], 1):
        L += [""] + field_lines(k, f)
    if pq.get("feedback"):
        L += ["", pq["feedback"]]
    for n in pq["notes"]:
        L.append(yellow("  note: " + n))
    return L


class QuizTimeUp(Exception):
    pass


def time_left(deadline):
    if not deadline:
        return ""
    s = int(deadline - time.time())
    if s <= 0:
        return red("time is up")
    h, rest = divmod(s, 3600)
    m_, s_ = divmod(rest, 60)
    t = f"{h}:{m_:02d}:{s_:02d}" if h else f"{m_}:{s_:02d}"
    return (red if s < 60 else yellow if s < 300 else green)(f"⏱ {t} left")


