class MoodleError(Exception):
    pass


def flatten(obj, prefix=""):
    """Encode nested params the way Moodle's REST server expects: a[0][b]=c"""
    out = []
    if isinstance(obj, dict):
        for k, v in obj.items():
            out += flatten(v, f"{prefix}[{k}]" if prefix else str(k))
    elif isinstance(obj, (list, tuple)):
        for i, v in enumerate(obj):
            out += flatten(v, f"{prefix}[{i}]")
    elif obj is not None:
        if isinstance(obj, bool):
            obj = int(obj)
        out.append((prefix, str(obj)))
    return out


def normalize_url(url):
    url = url.strip()
    if not re.match(r"^https?://", url, re.I):
        url = "https://" + url
    url = re.sub(r"/(login|my|course|user|mod|admin)(/.*)?$", "", url.split("?")[0].split("#")[0])
    return url.rstrip("/")


class Moodle:
    def __init__(self, url, token=None):
        self.url = normalize_url(url)
        self.token = token

    # -- low level ---------------------------------------------------------- #
    def _open(self, url, data=None, headers=None, timeout=60):
        h = {"User-Agent": UA}
        h.update(headers or {})
        req = urllib.request.Request(url, data=data, headers=h)
        try:
            return urllib.request.urlopen(req, timeout=timeout)
        except urllib.error.HTTPError as e:
            raise MoodleError(f"HTTP {e.code} {e.reason} ({url.split('?')[0]})")
        except urllib.error.URLError as e:
            raise MoodleError(f"cannot connect to {self.url}: {e.reason}")
        except TimeoutError:
            raise MoodleError(f"timeout talking to {self.url}")

    def _json(self, resp):
        raw = resp.read()
        try:
            return json.loads(raw.decode("utf-8"))
        except ValueError:
            snippet = raw[:200].decode("utf-8", "replace").strip()
            raise MoodleError(f"unexpected (non-JSON) answer from server: {snippet!r}")

    # -- login -------------------------------------------------------------- #
    def public_config(self):
        """Site config available without login (site name, login type, ...)."""
        body = json.dumps([{"index": 0, "methodname": "tool_mobile_get_public_config", "args": {}}]).encode()
        with self._open(self.url + "/lib/ajax/service-nologin.php?info=tool_mobile_get_public_config",
                        body, {"Content-Type": "application/json"}, timeout=20) as r:
            res = self._json(r)
        if isinstance(res, list) and res and not res[0].get("error"):
            return res[0].get("data") or {}
        raise MoodleError("public config not available")

    def login(self, username, password):
        data = urllib.parse.urlencode({"username": username, "password": password, "service": SERVICE}).encode()
        with self._open(self.url + "/login/token.php", data) as r:
            res = self._json(r)
        if not res.get("token"):
            code = res.get("errorcode", "")
            msg = res.get("error") or "login failed"
            hints = {
                "invalidlogin": "wrong username or password (if your site uses SSO/Microsoft/Google login, use `login --sso`)",
                "enablewsdescription": "this site has disabled web services / the mobile app — ask your Moodle admin",
                "servicenotavailable": "the mobile app service is disabled on this site",
                "sitepolicynotagreed": "you must accept the site policy once (in any browser, e.g. your phone), then retry",
                "usernotconfirmed": "your account is not confirmed yet",
            }
            raise MoodleError(f"{msg}" + (f"\n  hint: {hints[code]}" if code in hints else ""))
        self.token = res["token"]
        return res

    # -- web service calls -------------------------------------------------- #
    def call(self, function, **params):
        if not self.token:
            raise MoodleError("not logged in — run `login`")
        fields = [("wstoken", self.token), ("wsfunction", function), ("moodlewsrestformat", "json")]
        data = urllib.parse.urlencode(fields + flatten(params)).encode()
        with self._open(f"{self.url}/webservice/rest/server.php?wsfunction={function}", data) as r:
            res = self._json(r)
        if isinstance(res, dict) and "exception" in res:
            code = res.get("errorcode", "")
            raise MoodleError(f"{function}: {res.get('message', '')} [{code}]" +
                              ("\n  hint: your login expired — run `login` again" if code in ("invalidtoken", "accessexception") and "token" in res.get("message", "").lower() else ""))
        return res

    def try_call(self, functions, **params):
        """Try several function names (for compatibility with older/newer Moodles)."""
        last = None
        for fn in functions:
            try:
                return self.call(fn, **params)
            except MoodleError as e:
                last = e
                if "invalidtoken" in str(e):
                    raise
        raise last

    # -- files -------------------------------------------------------------- #
    def file_url(self, url):
        if "/pluginfile.php" in url and "/webservice/pluginfile.php" not in url:
            url = url.replace("/pluginfile.php", "/webservice/pluginfile.php", 1)
        sep = "&" if "?" in url else "?"
        return f"{url}{sep}token={urllib.parse.quote(self.token)}"

    def fetch(self, url):
        with self._open(self.file_url(url), timeout=120) as r:
            return r.read()

    def download(self, url, dest, mtime=None, show=True):
        dest = Path(dest)
        dest.parent.mkdir(parents=True, exist_ok=True)
        tmp = dest.with_name(dest.name + ".part")
        with self._open(self.file_url(url), timeout=300) as r:
            ctype = r.headers.get("Content-Type", "")
            total = int(r.headers.get("Content-Length") or 0)
            if "application/json" in ctype and not dest.name.endswith(".json"):
                res = self._json(r)
                raise MoodleError(res.get("error") or res.get("message") or "download failed")
            done = 0
            with open(tmp, "wb") as f:
                while True:
                    chunk = r.read(65536)
                    if not chunk:
                        break
                    f.write(chunk)
                    done += len(chunk)
                    if show and sys.stderr.isatty() and total > 1_000_000:
                        print(f"\r    {done * 100 // total:3d}%  {human(done)} / {human(total)}", end="", file=sys.stderr)
            if show and sys.stderr.isatty() and total > 1_000_000:
                print("\r" + " " * 40 + "\r", end="", file=sys.stderr)
        tmp.replace(dest)
        if mtime:
            os.utime(dest, (mtime, mtime))
        return done

    def upload(self, paths):
        """Upload files into a new draft area; returns its itemid."""
        boundary = uuid.uuid4().hex
        chunks = []
        for k, v in (("token", self.token), ("filearea", "draft"), ("itemid", "0")):
            chunks.append(f'--{boundary}\r\nContent-Disposition: form-data; name="{k}"\r\n\r\n{v}\r\n'.encode())
        for i, p in enumerate(paths):
            p = Path(p)
            ctype = mimetypes.guess_type(p.name)[0] or "application/octet-stream"
            fname = p.name.replace('"', "_")
            chunks.append(f'--{boundary}\r\nContent-Disposition: form-data; name="file_{i}"; filename="{fname}"\r\n'
                          f"Content-Type: {ctype}\r\n\r\n".encode())
            chunks.append(p.read_bytes())
            chunks.append(b"\r\n")
        chunks.append(f"--{boundary}--\r\n".encode())
        with self._open(self.url + "/webservice/upload.php", b"".join(chunks),
                        {"Content-Type": f"multipart/form-data; boundary={boundary}"}, timeout=600) as r:
            res = self._json(r)
        if isinstance(res, dict):
            raise MoodleError(res.get("error") or res.get("message") or "upload failed")
        if not res or "itemid" not in res[0]:
            raise MoodleError(f"upload failed: {res}")
        return res[0]["itemid"]


