    def toggle_done(self, mod):
        state = (mod.get("completiondata") or {}).get("state", 0)
        new = 0 if state in (1, 2) else 1
        res = self.need().call("core_completion_update_activity_completion_status_manually", cmid=mod["id"], completed=new)
        if not res.get("status"):
            raise MoodleError("could not change completion (it may be automatic)")
        mod.setdefault("completiondata", {})["state"] = new
        return new

    def do_done(self, arg):
