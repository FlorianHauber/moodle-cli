try:
    import curses
except ImportError:  # pragma: no cover
    curses = None

TEXT_EXT = {".txt", ".md", ".csv", ".tsv", ".py", ".c", ".h", ".cpp", ".java", ".js", ".ts", ".json",
            ".xml", ".yaml", ".yml", ".tex", ".log", ".sh", ".sql", ".r", ".m", ".ini", ".cfg", ".rst"}


class TUI:
    TABS = [("Courses", CoursesView), ("To-do", TodoView), ("Assignments", AssignmentsView),
            ("Grades", GradesView), ("Messages", MessagesView), ("Notifications", NotificationsView),
            ("Calendar", CalendarView), ("Quizzes", QuizzesView)]

    def __init__(self, sh):
        self.sh = sh
        self.stacks = [None] * len(self.TABS)
        self.tab = 0
        self.msg = ""
        self.tab_pos = []
        self.h, self.w = 24, 80

    @property
    def view(self):
        return self.stacks[self.tab][-1]

    def body_h(self):
        return max(1, self.h - 3)

    # -- setup -------------------------------------------------------------- #
    def run(self):
        import locale
        locale.setlocale(locale.LC_ALL, "")
        os.environ.setdefault("ESCDELAY", "25")
        curses.wrapper(self.main)

    def main(self, scr):
        self.scr = scr
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        scr.keypad(True)
        try:
            curses.use_default_colors()
            for i in range(1, 8):
                curses.init_pair(i, i, -1)
        except curses.error:
            pass
        try:
            curses.mousemask(curses.ALL_MOUSE_EVENTS)
            curses.mouseinterval(0)
        except curses.error:
            pass
        self.h, self.w = scr.getmaxyx()
        self.switch(0)
        while True:
            self.draw()
            try:
                k = scr.get_wch()
            except KeyboardInterrupt:
                self.msg = yellow("press q to quit")
                continue
            except curses.error:
                continue
            self.msg = ""
            try:
                if self.handle(k) == "quit":
                    break
            except MoodleError as e:
                self.msg = red("error: " + str(e).split("\n")[0])
            except KeyboardInterrupt:
                self.msg = yellow("interrupted")

    # -- navigation --------------------------------------------------------- #
    def switch(self, i):
        self.tab = i % len(self.TABS)
        if self.stacks[self.tab] is None:
            v = self.TABS[self.tab][1](self)
            self.stacks[self.tab] = [v]
            self.load(v)

    def push(self, v):
        self.stacks[self.tab].append(v)
        self.load(v)

    def pop(self):
        if len(self.stacks[self.tab]) > 1:
            self.stacks[self.tab].pop()

    def load(self, v):
        loading = dim("loading…")
        self.status(loading)
        try:
            v.load()
            if self.msg == loading:
                self.msg = ""
        except MoodleError as e:
            v.all_rows = v.rows = text_rows(red("error: " + str(e)))
            v.sel, v.loaded = -1, True
            self.msg = red("error: " + str(e).split("\n")[0])

    def status(self, msg):
        self.msg = msg
        self.draw()

    # -- input -------------------------------------------------------------- #
    def handle(self, k):
        v = self.view
        d = v.current
        K = curses
        if k == K.KEY_RESIZE:
            curses.update_lines_cols()
            return
        if k == K.KEY_MOUSE:
            return self.mouse()
        if v.key(k, d):
            return
        if k in ("q", "Q"):
            return "quit"
        if isinstance(k, str) and len(k) == 1 and k in "12345678":
            return self.switch(int(k) - 1)
        if k in (K.KEY_UP, "k"):
            v.move(-1)
        elif k in (K.KEY_DOWN, "j"):
            v.move(1)
        elif k in (K.KEY_NPAGE, " ", "\x04"):
            v.scroll(self.body_h() - 1)
        elif k in (K.KEY_PPAGE, "\x15"):
            v.scroll(-(self.body_h() - 1))
        elif k in (K.KEY_HOME, "g"):
            v.home()
        elif k in (K.KEY_END, "G"):
            v.end()
        elif k == "\t":
            self.switch(self.tab + 1)
        elif k == K.KEY_BTAB:
            self.switch(self.tab - 1)
        elif k in ("\n", "\r", K.KEY_ENTER, K.KEY_RIGHT, "l"):
            if d is not None:
                v.enter(d)
        elif k in (K.KEY_LEFT, "h", K.KEY_BACKSPACE, "\x7f", "\x08", "\x1b"):
            if v.filter:
                v.filter = ""
                v.apply_filter()
            else:
                self.pop()
        elif k == "/":
            s = self.prompt("/", v.filter)
            if s is not None:
                v.filter = s.strip()
                v.apply_filter()
        elif k in ("r", K.KEY_F5):
            self.load(v)
        elif k == "?":
            self.push(HelpView(self))

    def mouse(self):
        try:
            _, mx, my, _, b = curses.getmouse()
        except curses.error:
            return
        v = self.view
        b4 = getattr(curses, "BUTTON4_PRESSED", 0)
        b5 = getattr(curses, "BUTTON5_PRESSED", 0x200000)
        if b & b4:
            return v.scroll(-3)
        if b & b5:
            return v.scroll(3)
        if not b & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED | curses.BUTTON1_DOUBLE_CLICKED | curses.BUTTON1_RELEASED):
            return
        if b & curses.BUTTON1_RELEASED and not b & curses.BUTTON1_CLICKED:
            return
        if my == 0:
            for i, (x0, x1) in enumerate(self.tab_pos):
                if x0 <= mx < x1:
                    return self.switch(i)
            return
        if my == 1:
            return self.pop()
        idx = v.top + my - 2
        if 2 <= my < 2 + self.body_h() and idx < len(v.rows) and v.rows[idx].sel:
            if idx == v.sel or b & curses.BUTTON1_DOUBLE_CLICKED:
                v.sel = idx
                v.enter(v.current)
            else:
                v.sel = idx

    def prompt(self, label, initial=""):
        buf = list(initial or "")
        try:
            curses.curs_set(1)
        except curses.error:
            pass
        try:
            while True:
                self.h, self.w = self.scr.getmaxyx()
                text = label + "".join(buf)
                shown = text[-(self.w - 2):]
                self.scr.move(self.h - 1, 0)
                self.scr.clrtoeol()
                self.put(self.h - 1, 0, shown, curses.A_BOLD)
                self.scr.move(self.h - 1, min(self.w - 2, sum(char_w(c) for c in shown)))
                self.scr.refresh()
                ch = self.scr.get_wch()
                if ch in ("\n", "\r", curses.KEY_ENTER):
                    return "".join(buf)
                if ch == "\x1b":
                    return None
                if ch in (curses.KEY_BACKSPACE, "\x7f", "\x08"):
                    if buf:
                        buf.pop()
                elif ch == "\x15":
                    buf.clear()
                elif ch == "\x17":  # ctrl-w
                    while buf and buf[-1] == " ":
                        buf.pop()
                    while buf and buf[-1] != " ":
                        buf.pop()
                elif isinstance(ch, str) and ch.isprintable():
                    buf.append(ch)
        except KeyboardInterrupt:
            return None
        finally:
            try:
                curses.curs_set(0)
            except curses.error:
                pass

    def suspended(self, fn, pause=True):
        """Leave curses temporarily (for $EDITOR, file prompts, pagers)."""
        curses.def_prog_mode()
        curses.endwin()
        print()
        try:
            fn()
        except MoodleError as e:
            err(e)
        except (KeyboardInterrupt, EOFError):
            print("\ncancelled.")
        if pause:
            try:
                print(dim("\n[Enter] back to moodle "), end="", flush=True)
                input()
            except (EOFError, KeyboardInterrupt):
                pass
        curses.reset_prog_mode()
        self.scr.clear()
        self.scr.refresh()

    def open_file(self, f, dest):
        if not self.sh.up_to_date(f, dest):
            self.sh.fetch_files([(f, dest)], force=True, log=self.status, show=False)
        path = str(dest)
        opener = os.environ.get("MOODLE_OPENER")
        less = ["less", "-R"] if shutil.which("less") else None
        ext = dest.suffix.lower()
        mt = mimetypes.guess_type(path)[0] or ""
        if opener:
            self.suspended(lambda: subprocess.call(shlex.split(opener) + [path]), pause=False)
        elif (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")) and shutil.which("xdg-open"):
            subprocess.Popen(["xdg-open", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            self.msg = green(f"opened {dest.name}")
        elif less and ext == ".pdf" and shutil.which("pdftotext"):
            def run():
                p = subprocess.Popen(["pdftotext", "-layout", path, "-"], stdout=subprocess.PIPE)
                subprocess.call(less, stdin=p.stdout)
                p.wait()
            self.suspended(run, pause=False)
        elif less and ext in (".html", ".htm"):
            txt = html2text(dest.read_text("utf-8", "replace"))
            self.suspended(lambda: subprocess.run(less, input=txt.encode()), pause=False)
        elif less and (mt.startswith("text/") or ext in TEXT_EXT):
            self.suspended(lambda: subprocess.call(less + [path]), pause=False)
        else:
            hint = " (install poppler for pdftotext)" if ext == ".pdf" else ""
            self.msg = yellow(f"saved to {path} — no terminal viewer for {ext or 'this file'}{hint}")

    def sync_course(self, c):
        self.status(dim(f"syncing {c['shortname']}…"))
        got, skipped = self.sh.sync_course(c, log=self.status, show=False)
        self.msg = green(f"✓ {c['shortname']}: {got} downloaded, {skipped} up to date → {self.sh.dl_dir() / safe_name(c['shortname'])}")

    # -- drawing ------------------------------------------------------------ #
    def put(self, y, x, text, attr=0):
        """Draw plain text, clipped to the screen width."""
        if y >= self.h or x >= self.w - 1:
            return x
        out, col = [], x
        for ch in text:
            if not ch.isprintable():
                continue
            cw = char_w(ch)
            if col + cw > self.w - 1:
                break
            out.append(ch)
            col += cw
        try:
            self.scr.addstr(y, x, "".join(out), attr)
        except curses.error:
            pass
        return col

    def put_ansi(self, y, x, text, extra=0, fill=False):
        attr, pos, col = 0, 0, x
        segs = []
        for m in ANSI_RE.finditer(text):
            if m.start() > pos:
                segs.append((text[pos:m.start()], attr))
            for code in (m.group(1) or "0").split(";"):
                code = int(code or 0)
                if code == 0:
                    attr = 0
                elif code == 1:
                    attr |= curses.A_BOLD
                elif code == 2:
                    attr |= curses.A_DIM
                elif 30 <= code <= 37:
                    attr = (attr & ~curses.A_COLOR) | curses.color_pair(code - 30)
            pos = m.end()
        segs.append((text[pos:], attr))
        for seg, a in segs:
            if seg:
                col = self.put(y, col, seg, a | extra)
        if fill and col < self.w - 1:
            self.put(y, col, " " * (self.w - 1 - col), extra)

    def draw(self):
        scr = self.scr
        self.h, self.w = scr.getmaxyx()
        scr.erase()
        # tab bar
        x, self.tab_pos = 0, []
        for i, (name, _) in enumerate(self.TABS):
            label = f" {i + 1} {name} "
            a = curses.A_REVERSE | curses.A_BOLD if i == self.tab else curses.A_DIM
            nx = self.put(0, x, label, a)
            self.tab_pos.append((x, nx))
            x = nx + 1
        v = self.view
        crumbs = " › ".join(s.title for s in self.stacks[self.tab])
        if v.filter:
            crumbs += f"   [filter: {v.filter}]"
        self.put_ansi(1, 0, cyan(bold(crumbs)) if USE_COLOR else crumbs)
        # body
        v.clamp()
        bh = self.body_h()
        for i in range(bh):
            idx = v.top + i
            if idx >= len(v.rows):
                break
            selected = idx == v.sel
            self.put_ansi(2 + i, 0, v.rows[idx].text, curses.A_REVERSE if selected else 0, fill=selected)
        # footer
        n = len(v.rows)
        right = f" {v.top + 1}-{min(n, v.top + bh)}/{n} " if n > bh else ""
        left = self.msg or dim(f"{v.hint}{'  ·  ' if v.hint else ''}← back  ? help  q quit")
        self.put_ansi(self.h - 1, 0, left)
        if right and len(right) < self.w - 2:
            self.put(self.h - 1, self.w - 1 - len(right), right, curses.A_DIM)
        scr.refresh()


def run_tui(sh):
    if curses is None:
        raise MoodleError("Python curses module not available")
    if not sys.stdout.isatty():
        raise MoodleError("the full-screen interface needs a terminal")
    if not sh.logged_in:
        print("Not logged in yet — let's do that first.\n")
        sh.do_login("")
    TUI(sh).run()


# --------------------------------------------------------------------------- #

def main():
    sh = Shell()
    argv = sys.argv[1:]
    if argv and argv[0] in ("-h", "--help", "help"):
        print(HELP.strip())
        return
    if argv and argv[0] in ("-V", "--version"):
        print(f"{APP} {VERSION}")
        return
    if not argv or argv[0] == "tui":
        if sys.stdout.isatty() and curses is not None:
            try:
                return run_tui(sh)
            except MoodleError as e:
                return err(e)
            except KeyboardInterrupt:
                return print()
        argv = ["shell"]
    if argv[0] != "shell":
        sh.onecmd(" ".join(shlex.quote(a) for a in argv))
        return

    try:
        import readline
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        try:
            readline.read_history_file(HISTORY_FILE)
        except OSError:
            pass
        readline.set_history_length(1000)
    except ImportError:
        readline = None

    if sh.logged_in:
        print(f"{bold('moodle')} · {sh.cfg.get('fullname', '')} @ {sh.cfg.get('sitename', sh.m.url)}   "
              + dim("type `help` for commands, `tui` for the full-screen view"))
    else:
        print(f"{bold('moodle')} — not logged in yet. Type {cyan('login')} to start, {cyan('help')} for commands.")
    try:
        sh.cmdloop()
    except KeyboardInterrupt:
        print()
    finally:
        if readline:
            try:
                readline.write_history_file(HISTORY_FILE)
            except OSError:
                pass


if __name__ == "__main__":
    main()
