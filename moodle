    def course_grade_lines(self, c):
        res = self.need().call("gradereport_user_get_grade_items", courseid=c["id"], userid=self.uid)
        ug = (res.get("usergrades") or [{}])[0]
        L = [bold(html2text(c["fullname"], links=False)), ""]
        items = ug.get("gradeitems") or []
        namew = min(50, max([len(html2text(i.get("itemname") or "", links=False)) for i in items] + [14]))
        L.append(dim(f"{'Item':<{namew}}  {'Grade':>10}  {'Range':>10}  {'%':>8}"))
        for it in items:
            name = html2text(it.get("itemname") or ("Course total" if it.get("itemtype") == "course" else "Category total"), links=False)
            grade = html2text(it.get("gradeformatted"), links=False) or "-"
            line = f"{name[:namew]:<{namew}}  {grade:>10}  {html2text(it.get('rangeformatted'), links=False):>10}  {html2text(it.get('percentageformatted'), links=False):>8}"
            L.append(bold(line) if it.get("itemtype") in ("course", "category") else line)
            if it.get("feedback"):
                L.append(html2text(it["feedback"], indent="    │ "))
