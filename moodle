BLOCK = {"p", "div", "h1", "h2", "h3", "h4", "h5", "h6", "tr", "table", "ul", "ol",
         "blockquote", "pre", "section", "article", "header", "footer", "hr", "dl",
         "dt", "dd", "figure", "figcaption"}


class _H2T(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.parts, self.links = [], []
        self.skip = self.pre = 0
        self.href = None

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if tag in ("script", "style", "head", "title"):
            self.skip += 1
        elif tag == "br":
            self.parts.append("\n")
        elif tag == "li":
            self.parts.append("\n  • ")
        elif tag in ("td", "th"):
            self.parts.append("  ")
        elif tag == "img":
            self.parts.append(f"[{a.get('alt') or 'image'}]")
        elif tag == "a":
            self.href = a.get("href")
        elif tag in BLOCK:
            self.parts.append("\n\n" if tag in ("p", "h1", "h2", "h3") else "\n")
        if tag == "pre":
            self.pre += 1

    def handle_endtag(self, tag):
        if tag in ("script", "style", "head", "title"):
            self.skip = max(0, self.skip - 1)
        elif tag == "a":
            if self.href and not self.href.startswith(("#", "javascript:", "mailto:")):
                self.links.append(self.href)
                self.parts.append(f"[{len(self.links)}]")
            self.href = None
        elif tag in BLOCK:
            self.parts.append("\n")
        if tag == "pre":
            self.pre = max(0, self.pre - 1)

    def handle_data(self, data):
        if not self.skip:
            self.parts.append(data if self.pre else re.sub(r"\s+", " ", data))


def html2text(s, links=True, indent=""):
    if not s:
        return ""
    p = _H2T()
    try:
        p.feed(s)
        p.close()
        text = "".join(p.parts)
    except Exception:
        text = re.sub(r"<[^>]+>", " ", s)
    w = width() - len(indent)
    out = []
    for line in text.split("\n"):
        line = line.rstrip()
        if not line.startswith("  •"):
            line = line.strip()
        if len(line) > w:
            lead = " " * (len(line) - len(line.lstrip()) + (2 if line.startswith("  •") else 0))
            out += textwrap.wrap(line, w, subsequent_indent=lead) or [""]
        else:
            out.append(line)
    text = re.sub(r"\n{3,}", "\n\n", "\n".join(out)).strip()
    if links and p.links:
        text += "\n\n" + "\n".join(dim(f"[{i}] {u}") for i, u in enumerate(p.links, 1))
    if indent:
        text = "\n".join(indent + l for l in text.split("\n"))
    return text


