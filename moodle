    def conv_rows(self):
        res = self.need().call("core_message_get_conversations", userid=self.uid, limitnum=40)
        self.convs = res.get("conversations", [])
        rows = []
        for i, c in enumerate(self.convs, 1):
            unread = c.get("unreadcount") or 0
            last = (c.get("messages") or [{}])[0]
            preview = textwrap.shorten(html2text(last.get("text"), links=False).replace("\n", " ") or "", 60, placeholder="…")
            rows.append((f"[{i:>3}] {bold(self.conv_name(c)) if unread else self.conv_name(c)}"
                         + (blue(f" ({unread} new)") if unread else "") + f"  {dim(rel(last.get('timecreated')))}", c))
            if preview:
                rows.append((dim("        " + preview), None))
        return rows

    def do_messages(self, arg):
        """messages  — list your conversations."""
        rows = self.conv_rows()
        L = [t for t, _ in rows] + [dim("\n  open: chat <n>     new: write <name>")]
        page("\n".join(L) if self.convs else "No conversations. Start one with: write <name>")

    def conversation_lines(self, conv):
        res = self.need().call("core_message_get_conversation_messages", currentuserid=self.uid,
                               convid=conv["id"], limitnum=50, newest=1)
        names = {mm["id"]: mm.get("fullname") for mm in res.get("members") or []}
        names[self.uid] = "You"
        out = [bold(self.conv_name(conv)), ""]
        for msg in reversed(res.get("messages") or []):
            who = names.get(msg.get("useridfrom"), "?")
            col = green if msg.get("useridfrom") == self.uid else cyan
            out.append(f"{col(bold(who))}  {dim(fmt_time(msg.get('timecreated')))}")
            out.append(html2text(msg.get("text"), indent="  "))
        try:
            self.m.call("core_message_mark_all_conversation_messages_as_read", userid=self.uid, conversationid=conv["id"])
        except MoodleError:
            pass
        return out

    def send_to_conv(self, conv, text):
        self.need().call("core_message_send_messages_to_conversation", conversationid=conv["id"],
                         messages=[{"text": text, "textformat": 2}])

    def do_chat(self, arg):
        """chat <n>  — read a conversation and reply (empty line = back, /r = refresh)."""
        if not self.convs:
            self.conv_rows()
        conv = self.convs[parse_nums(args_of(arg) or ["?"], len(self.convs))[0] - 1]
        print("\n".join(self.conversation_lines(conv)))
        if not sys.stdin.isatty():
            return
        print(dim("\nType a message and press Enter to send. Empty line = back, /r = refresh."))
        while True:
            try:
                line = input(green("you> ")).strip()
            except (EOFError, KeyboardInterrupt):
                print()
                break
            if not line:
                break
            if line == "/r":
                print("\n".join(self.conversation_lines(conv)))
                continue
            self.send_to_conv(conv, line)
            print(dim("  sent ✓"))

    def do_write(self, arg):
        """write <name> [message]  — send a private message to someone."""
        a = args_of(arg)
        if not a:
            raise MoodleError("usage: write <name> [message]")
        res = self.need().call("core_message_message_search_users", userid=self.uid, search=a[0], limitnum=20)
        people = (res.get("contacts") or []) + (res.get("noncontacts") or [])
        if not people:
            raise MoodleError(f"nobody found for '{a[0]}'")
        if len(people) > 1:
            for i, p in enumerate(people, 1):
                print(f"[{i:>2}] {p.get('fullname')}")
            pick = input("who? ").strip()
            person = people[parse_nums([pick], len(people))[0] - 1]
        else:
            person = people[0]
        text = " ".join(a[1:]) or input(f"message to {person.get('fullname')}: ").strip()
        if not text:
            return print("cancelled.")
        out = self.m.call("core_message_send_instant_messages",
                          messages=[{"touserid": person["id"], "text": text, "textformat": 2}])
        if out and out[0].get("errormessage"):
            raise MoodleError(out[0]["errormessage"])
        print(green("✓ ") + f"sent to {person.get('fullname')}")

