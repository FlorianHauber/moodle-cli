USE_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR") and os.environ.get("TERM") != "dumb"


def _c(code):
    return lambda t: f"\033[{code}m{t}\033[0m" if USE_COLOR else str(t)


bold, dim, red, green, yellow, blue, magenta, cyan = (
    _c("1"), _c("2"), _c("31"), _c("32"), _c("33"), _c("34"), _c("35"), _c("36"))


def err(msg):
    print(red("error: ") + str(msg), file=sys.stderr)


def info(msg):
    print(dim(msg), file=sys.stderr)


def width():
    return max(40, min(shutil.get_terminal_size((100, 24)).columns, 110))


def page(text):
    """Print text, through a pager if it does not fit on the screen."""
    if not sys.stdout.isatty():
        print(text)
        return
    rows = shutil.get_terminal_size((100, 24)).lines
    if text.count("\n") + 2 < rows:
        print(text)
        return
    pager = os.environ.get("PAGER")
    argv = shlex.split(pager) if pager else ["less", "-R", "-F", "-X"]
    try:
        p = subprocess.Popen(argv, stdin=subprocess.PIPE)
        p.communicate(text.encode("utf-8", "replace"))
    except (FileNotFoundError, OSError):
        print(text)


def human(n):
    n = float(n or 0)
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def fmt_time(ts):
    if not ts:
        return "-"
    return datetime.fromtimestamp(int(ts)).strftime("%a %d %b %Y %H:%M")


def rel(ts):
    if not ts:
        return ""
    d = int(ts) - time.time()
    a = abs(d)
    if a < 3600:
        s = f"{int(a // 60)}m"
    elif a < 86400:
        s = f"{int(a // 3600)}h {int(a % 3600 // 60)}m"
    else:
        s = f"{int(a // 86400)}d {int(a % 86400 // 3600)}h"
    return f"in {s}" if d > 0 else f"{s} ago"


def due_color(ts, text):
    if not ts:
        return text
    d = int(ts) - time.time()
    if d < 0:
        return red(text)
    if d < 86400 * 2:
        return yellow(text)
    return text


def safe_name(name, limit=100):
    name = re.sub(r"[/\\\x00-\x1f]", "_", str(name or "")).strip().strip(".")
    return (name or "_")[:limit]


def confirm(question, default=False):
    if not sys.stdin.isatty():
        return default
    hint = "[Y/n]" if default else "[y/N]"
    try:
        ans = input(f"{question} {hint} ").strip().lower()
    except EOFError:
        return default
    return default if not ans else ans in ("y", "yes", "j", "ja")


def args_of(line):
    try:
        return shlex.split(line)
    except ValueError:
        return line.split()


def parse_nums(tokens, maximum):
    """'1 3 5-7' -> [1,3,5,6,7]; 'all' -> 1..maximum"""
    out = []
    for t in tokens:
        if t == "all":
            return list(range(1, maximum + 1))
        m = re.fullmatch(r"(\d+)-(\d+)", t)
        if m:
            out += list(range(int(m.group(1)), int(m.group(2)) + 1))
        elif t.isdigit():
            out.append(int(t))
        else:
            raise MoodleError(f"not a number: {t}")
    for n in out:
        if not 1 <= n <= maximum:
            raise MoodleError(f"number {n} out of range (1-{maximum})")
    return out


def edit_text(initial=""):
    """Open $EDITOR for longer text; returns the text (without # comment lines)."""
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR")
    if not editor:
        for e in ("nano", "vim", "vi"):
            if shutil.which(e):
                editor = e
                break
    if not editor:
        print("No $EDITOR found. Type your text, finish with a line containing only '.':")
        lines = []
        while True:
            try:
                ln = input()
            except EOFError:
                break
            if ln == ".":
                break
            lines.append(ln)
        return "\n".join(lines).strip()
    with tempfile.NamedTemporaryFile("w+", suffix=".txt", delete=False) as f:
        f.write(initial + "\n# Lines starting with # are ignored. Save and quit to send; leave empty to cancel.\n")
        path = f.name
    try:
        subprocess.call(shlex.split(editor) + [path])
        with open(path, encoding="utf-8") as f:
            return "\n".join(l for l in f.read().splitlines() if not l.startswith("#")).strip()
    finally:
        os.unlink(path)


def text_to_html(text):
    import html as _h
    paras = [p for p in re.split(r"\n\s*\n", text.strip()) if p.strip()]
    return "".join("<p>" + _h.escape(p).replace("\n", "<br>") + "</p>" for p in paras)


