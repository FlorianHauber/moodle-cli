    def submission_status(self, x):
        return self.need().call("mod_assign_get_submission_status", assignid=x["id"])

    def assignment_lines(self, x, hints=True):
        L = [bold(html2text(x["name"], links=False)) + dim(f"   {x['_course'].get('fullname', '')}")]
        for label, key in (("Opens", "allowsubmissionsfromdate"), ("Due", "duedate"), ("Cut-off", "cutoffdate")):
            if x.get(key):
                L.append(f"{label + ':':9}{due_color(x[key], fmt_time(x[key]))}  {dim(rel(x[key]))}")
        if x.get("intro"):
            L += ["", html2text(x["intro"])]
        att = x.get("introattachments") or []
        if att:
            L += ["", bold("Attachments:")] + [f"  {f['filename']}  {dim(human(f.get('filesize')))}" for f in att]
        try:
            st = self.submission_status(x)
        except MoodleError as e:
            return L + ["", dim(f"(submission status unavailable: {e})")]
        last = st.get("lastattempt") or {}
        sub = last.get("submission") or last.get("teamsubmission") or {}
        status = sub.get("status", "new")
        scol = green if status == "submitted" else yellow if status == "draft" else red
        L += ["", f"{bold('Submission:')} {scol(status)}   grading: {last.get('gradingstatus', '-')}"
                  + (f"   last change {fmt_time(sub.get('timemodified'))}" if sub.get("timemodified") else "")]
        for p in sub.get("plugins") or []:
            for fa in p.get("fileareas") or []:
                for f in fa.get("files") or []:
                    L.append(f"  * {f.get('filename')}  {dim(human(f.get('filesize')))}")
            for ef in p.get("editorfields") or []:
                if ef.get("text") and p.get("type") == "onlinetext":
                    L.append(html2text(ef["text"], indent="  │ "))
