def unquote_path(s):
    s = s.strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in "'\"":
        s = s[1:-1]
    if s.startswith("file://"):
        s = urllib.parse.unquote(s[7:])
    return os.path.expanduser(s)


def ask_paths():
    """Ask for file paths one per line, with Tab completion. Empty line ends."""
    try:
        import readline
    except ImportError:
        readline = None
    import glob

    def comp(text, state):
        t = unquote_path(text) if text else ""
        hits = [p + ("/" if os.path.isdir(p) else "") for p in sorted(glob.glob(glob.escape(t) + "*"))]
        return hits[state] if state < len(hits) else None

    if readline:
        old = (readline.get_completer(), readline.get_completer_delims())
        readline.set_completer(comp)
        readline.set_completer_delims("")
        if "libedit" in (readline.__doc__ or "") or getattr(readline, "backend", "") == "editline":
            readline.parse_and_bind("bind ^I rl_complete")
        else:
            readline.parse_and_bind("tab: complete")
    paths = []
    try:
        while True:
            try:
                s = input(f"file {len(paths) + 1}: ")
            except EOFError:
                break
            if not s.strip():
                break
            p = Path(unquote_path(s))
            if not p.is_file():
                err(f"not a file: {p}")
                continue
            paths.append(p)
    finally:
        if readline:
            readline.set_completer(old[0])
            readline.set_completer_delims(old[1])
    return paths


class Shell(cmd.Cmd):
    doc_header = "Commands (type help <command>):"

    def __init__(self):
        super().__init__()
        self.cfg = load_config()
        self.m = Moodle(self.cfg["url"], self.cfg.get("token")) if self.cfg.get("url") else None
        self._courses = None
        self.course = None
        self.sections, self.modules = [], []
        self.assigns, self.convs, self.discussions, self.posts = [], [], [], []
        self.quizzes = []
        self.forum = self.discussion = None
        self.update_prompt()

    # -- plumbing ----------------------------------------------------------- #
    def update_prompt(self):
        where = self.course["shortname"] if self.course else ""
        self.prompt = (f"\001\033[1;36m\002moodle\001\033[0m\002{':' + where if where else ''}> "
                       if USE_COLOR else f"moodle{':' + where if where else ''}> ")

    def onecmd(self, line):
        try:
            return super().onecmd(line)
        except MoodleError as e:
            err(e)
        except KeyboardInterrupt:
            print()
        except (BrokenPipeError, EOFError):
            pass
        return False

    def emptyline(self):
        return False

    def default(self, line):
        err(f"unknown command: {line.split()[0]}  (type `help`)")

    def do_help(self, arg):
        if arg:
            return super().do_help(arg)
        page(HELP.strip())

    def do_quit(self, arg):
        """Leave the program."""
        return True

    do_exit = do_quit

    def do_EOF(self, arg):
        print()
        return True

    def do_tui(self, arg):
        """Open the full-screen interface."""
        run_tui(self)

    @property
    def uid(self):
        return self.cfg.get("userid")

    @property
    def logged_in(self):
        return bool(self.m and self.m.token)

    def need(self):
        if not self.logged_in:
            raise MoodleError("not logged in — run `login`")
        return self.m

    def dl_dir(self):
        return Path(os.path.expanduser(self.cfg.get("download_dir") or DEFAULT_DL))

    # -- account ------------------------------------------------------------ #
    def do_login(self, arg):
        """login [--sso|--token] [url]  — log in (password is never stored, only the app token)."""
        a = args_of(arg)
        mode = "sso" if "--sso" in a else "token" if "--token" in a else "password"
        rest = [x for x in a if not x.startswith("--")]
        url = rest[0] if rest else input(f"Moodle site URL{' [' + self.cfg['url'] + ']' if self.cfg.get('url') else ''}: ").strip() or self.cfg.get("url", "")
        if not url:
            raise MoodleError("no URL given")
        m = Moodle(url)
        try:
            pub = m.public_config()
            m.url = normalize_url(pub.get("httpswwwroot") or pub.get("wwwroot") or m.url)
            print(f"Site: {bold(html2text(pub.get('sitename', ''), links=False))}  {dim(m.url)}")
            if mode == "password" and pub.get("typeoflogin") in (2, 3):
                print(yellow("This site sends app logins through a browser page (SSO)."))
                print("  1) try username + password anyway\n  2) SSO one-time link (open it on your phone or any device)\n  3) paste a token")
                choice = input("choose [2]: ").strip() or "2"
                mode = {"1": "password", "3": "token"}.get(choice, "sso")
        except MoodleError:
            info(f"(could not read public site info from {m.url} — continuing)")

        if mode == "password":
            user = input("Username: ").strip()
            pw = getpass.getpass("Password: ")
            m.login(user, pw)
        elif mode == "token":
            print(dim("Token from: Moodle > Preferences > Security keys (service 'Moodle mobile web service')."))
            m.token = getpass.getpass("Token: ").strip()
        else:
            self._sso(m)

        si = m.call("core_webservice_get_site_info")
        self.cfg.update(url=m.url, token=m.token, userid=si["userid"], fullname=si.get("fullname"),
                        sitename=si.get("sitename"), release=si.get("release"))
        save_config(self.cfg)
        self.m = m
        self._courses = None
        print(green("✓ ") + f"logged in as {bold(si.get('fullname'))} on {si.get('sitename')}")
        info(f"token saved to {CONFIG_FILE} (mode 600)")

    def _sso(self, m):
        passport = f"{random.random() * 1000:.6f}"
        link = (f"{m.url}/admin/tool/mobile/launch.php?service={SERVICE}"
                f"&passport={passport}&urlscheme=moodlemobile")
        print(textwrap.dedent(f"""
            {bold('SSO login')} — your site logs in through a web page, so this step needs
            a browser ONCE, on any device (your phone is fine). Nothing is read from it.

              1. Open this link and log in:
                 {cyan(link)}
              2. At the end it tries to open the Moodle app with an address that starts
                 with  {bold('moodlemobile://token=')}  — copy that address
                 (from the address bar, the error page, or the "open app" button's link).
              3. Paste it here.
            """))
        s = input("moodlemobile:// link: ").strip()
        mt = re.search(r"token=([A-Za-z0-9+/=_-]+)", s)
        if not mt:
            raise MoodleError("that does not contain token=...")
        b64 = mt.group(1).replace("-", "+").replace("_", "/")
        try:
            data = base64.b64decode(b64 + "=" * (-len(b64) % 4)).decode()
        except Exception:
            raise MoodleError("could not decode the token link")
        parts = data.split(":::")
        if len(parts) < 2:
            raise MoodleError("unexpected token format")
        sig = parts[0]
        ok = any(hashlib.md5((u + passport).encode()).hexdigest() == sig
                 for u in (m.url, m.url.replace("https://", "http://")))
        if not ok:
            print(yellow("warning: signature did not match this login attempt (old link?). Trying anyway."))
        m.token = parts[1]

    def do_logout(self, arg):
        """Forget the saved token."""
        for k in ("token", "userid", "fullname"):
            self.cfg.pop(k, None)
        save_config(self.cfg)
        if self.m:
            self.m.token = None
        print("logged out (token removed from this computer).")

    def do_whoami(self, arg):
        """Show account and site information."""
        si = self.need().call("core_webservice_get_site_info")
        print(f"{bold(si.get('fullname'))} ({si.get('username')}, id {si.get('userid')})")
        print(f"{si.get('sitename')}  {dim(self.m.url)}")
        print(dim(f"Moodle {si.get('release', '?')}  ·  config: {CONFIG_FILE}  ·  downloads: {self.dl_dir()}"))

    def do_dir(self, arg):
        """dir [path]  — show or set the download folder."""
        if arg.strip():
            p = Path(os.path.expanduser(arg.strip())).resolve()
            self.cfg["download_dir"] = str(p)
            save_config(self.cfg)
        print(self.dl_dir())

    def do_refresh(self, arg):
        """Clear cached lists (courses etc.)."""
        self._courses = None
        if self.course:
            self.load_course(self.course)
        print("cache cleared.")

    # -- courses ------------------------------------------------------------ #
    @staticmethod
    def is_past(c):
        return bool(c.get("enddate")) and c["enddate"] < time.time()

    GROUPS = ("current", "hidden", "past")

    def course_group(self, c):
        """0 = current, 1 = hidden from dashboard, 2 = past (your own `move` choice wins)"""
        ov = self.cfg.get("course_groups", {}).get(str(c["id"]))
        if ov in self.GROUPS:
            return self.GROUPS.index(ov)
        if self.is_past(c):
            return 2
        if c.get("hidden"):
            return 1
        return 0

    def courses(self, refresh=False):
        if self._courses is None or refresh:
            self._courses = self.need().call("core_enrol_get_users_courses", userid=self.uid)
            self.sort_courses()
        return self._courses

    def sort_courses(self):
        if self._courses is not None:
            self._courses = sorted(self._courses, key=lambda c: (self.course_group(c), not c.get("isfavourite"),
                                                      (c.get("fullname") or "").lower()))

    def set_group(self, courses, target):
        """target: current|hidden|past|auto — stored only on this computer."""
        ov = self.cfg.setdefault("course_groups", {})
        for c in courses:
            if target == "auto":
                ov.pop(str(c["id"]), None)
            else:
                ov[str(c["id"])] = target
        save_config(self.cfg)
        self.sort_courses()

    def do_move(self, arg):
        """move <n...> current|hidden|past|auto  — choose where courses are listed, e.g. `move 1-5 current`.
        Only changes this program (saved in your config), not the Moodle website. `auto` undoes it."""
        a = args_of(arg)
        targets = self.GROUPS + ("auto",)
        if len(a) < 2 or a[-1] not in targets:
            raise MoodleError("usage: move <n...> current|hidden|past|auto   e.g.  move 1-5 current")
        cs = self.courses()
        chosen = [cs[n - 1] for n in parse_nums(a[:-1], len(cs))]
        self.set_group(chosen, a[-1])
        print(green("✓ ") + f"{len(chosen)} course(s) → {a[-1]}   (numbers may have changed:)\n")
        self.do_courses("", refresh=False)

    def course_groups(self):
        groups = [("Current courses", []), ("Hidden from your dashboard", []), ("Past courses", [])]
        for i, c in enumerate(self.courses(), 1):
            groups[self.course_group(c)][1].append((i, c))
        return groups

    def course_line(self, i, c):
        star = yellow("★ ") if c.get("isfavourite") else "  "
        prog = c.get("progress")
        prog = dim(f"{prog:.0f}%") if isinstance(prog, (int, float)) else ""
        name = html2text(c.get("fullname"), links=False)
        group = self.course_group(c)
        why = ""
        if str(c["id"]) in self.cfg.get("course_groups", {}):
            why = dim("  (moved by you)")
        elif group == 2 and c.get("enddate"):
            why = dim(f"  (end date {datetime.fromtimestamp(c['enddate']).strftime('%d.%m.%Y')})")
        return f"[{i:>3}] {star}{dim(name) if group else bold(name)}  {dim(c.get('shortname', ''))} {prog}{why}"

    def find_course(self, arg, required=True):
        arg = (arg or "").strip()
        if not arg:
            if self.course:
                return self.course
            if self.cfg.get("last_course"):
                c = next((c for c in self.courses() if c["id"] == self.cfg["last_course"]), None)
                if c:
                    return c
            if required:
                raise MoodleError("which course? (see `courses`)")
            return None
        cs = self.courses()
        if arg.isdigit():
            n = int(arg)
            if 1 <= n <= len(cs):
                return cs[n - 1]
            raise MoodleError(f"no course number {n}")
        if arg.startswith("#") and arg[1:].isdigit():
            c = next((c for c in cs if c["id"] == int(arg[1:])), None)
            if c:
                return c
            raise MoodleError(f"no course with id {arg[1:]}")
        q = arg.lower()
        hits = [c for c in cs if q in (c.get("shortname") or "").lower() or q in (c.get("fullname") or "").lower()]
        if len(hits) == 1:
            return hits[0]
        exact = [c for c in hits if (c.get("shortname") or "").lower() == q]
        if len(exact) == 1:
            return exact[0]
        if not hits:
            raise MoodleError(f"no course matches '{arg}'")
        raise MoodleError(f"'{arg}' matches several courses: " + ", ".join(c["shortname"] for c in hits[:6]))

    def do_courses(self, arg, refresh=True):
        """courses  — list all your courses (current, hidden from dashboard, past)."""
        self.courses(refresh=refresh)
        L = []
        for title, items in self.course_groups():
            if not items:
                continue
            if L:
                L.append("")
            L.append(cyan(bold(f"{title} ({len(items)})")))
            L += [self.course_line(i, c) for i, c in items]
        if L:
            L.append(dim("\n  open: course <n>     regroup: move <n...> current|hidden|past|auto"))
        page("\n".join(L) if L else "You are not enrolled in any courses.")

    def course_modules(self, c):
        sections = self.need().call("core_course_get_contents", courseid=c["id"])
        mods = []
        for sec in sections:
            for mod in sec.get("modules", []):
                if mod.get("modname") == "label":
                    continue
                mod["_section"] = sec.get("name") or f"Section {sec.get('section')}"
                mods.append(mod)
        return sections, mods

    def load_course(self, c):
        self.sections, self.modules = self.course_modules(c)
        self.course = c
        if self.cfg.get("last_course") != c["id"]:
            self.cfg["last_course"] = c["id"]
            save_config(self.cfg)
        self.update_prompt()

    def ensure_modules(self):
        if not self.modules:
            self.load_course(self.find_course(""))
        return self.modules

    def get_mod(self, arg):
        mods = self.ensure_modules()
        a = args_of(arg)
        if not a:
            raise MoodleError("which item number?")
        return mods[parse_nums(a[:1], len(mods))[0] - 1]

    def course_rows(self, sections, header_course=None):
        """[(text, module-or-None)] for a course page."""
        rows = []
        if header_course:
            c = header_course
            rows.append((bold(html2text(c["fullname"], links=False)) + dim(f"   {c['shortname']} · id {c['id']}"), None))
        n = 0
        for sec in sections:
            mods = sec.get("modules", [])
            if not mods and not html2text(sec.get("summary"), links=False):
                continue
            if rows:
                rows.append(("", None))
            rows.append((cyan(bold("▌" + (sec.get("name") or f"Section {sec.get('section')}"))), None))
            summ = html2text(sec.get("summary"), links=False)
            if summ:
                lines = summ.splitlines()
                rows += [(dim("  " + x), None) for x in lines[:3]] + ([(dim("  …"), None)] if len(lines) > 3 else [])
            for mod in mods:
                if mod.get("modname") == "label":
                    t = html2text(mod.get("description"), links=False).replace("\n", " ").strip()
                    if t:
                        rows.append((dim("        " + (t[:width() - 12] + "…" if len(t) > width() - 11 else t)), None))
                    continue
                n += 1
                rows.append((self.mod_line(n, mod), mod))
        return rows

    def do_course(self, arg):
        """course <n|shortname|#id>  — open a course and list its contents."""
        c = self.find_course(arg)
        self.load_course(c)
        page("\n".join(t for t, _ in self.course_rows(self.sections, header_course=c)))

    def mod_line(self, n, mod):
        tag, col = TAGS.get(mod["modname"], (mod["modname"][:6], dim))
        name = html2text(mod.get("name"), links=False)
        extra = ""
        files = [f for f in mod.get("contents") or [] if f.get("type") == "file"]
        if mod["modname"] == "resource" and files:
            ext = Path(files[0]["filename"]).suffix.lstrip(".")
            extra = dim(f"  {ext} {human(files[0].get('filesize'))}")
        elif mod["modname"] == "folder" and files:
            extra = dim(f"  {len(files)} files")
        state = (mod.get("completiondata") or {}).get("state")
        done = green(" ✓") if state in (1, 2) else red(" ✗") if state == 3 else ""
        if not mod.get("uservisible", True):
            name = dim(name + " (locked)")
        return f"  [{n:>3}] {col(f'{tag:<6}')} {name}{extra}{done}"

