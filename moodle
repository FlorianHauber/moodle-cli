        kind = mod["modname"]
        L = [bold(html2text(mod["name"], links=False)) + dim(f"   ({mod.get('modplural', kind)} · {mod.get('_section', '')})")]
        if not mod.get("uservisible", True):
            L.append(yellow("Not available yet: ") + html2text(mod.get("availabilityinfo"), links=False))
        for d in mod.get("dates") or []:
            L.append(f"{d.get('label')} {fmt_time(d.get('timestamp'))}  {dim(rel(d.get('timestamp')))}")
        if mod.get("description"):
            L += ["", html2text(mod["description"])]
        if kind in ("page", "book"):
            for f in mod.get("contents") or []:
                if f.get("filename", "").endswith((".html", ".htm")):
                    L += ["", html2text(self.need().fetch(f["fileurl"]).decode("utf-8", "replace"))]
        elif kind == "url":
            for f in mod.get("contents") or []:
                L += ["", "Link: " + cyan(f.get("fileurl", ""))]
        files = [f for f in mod.get("contents") or [] if f.get("type") == "file" and kind not in ("page", "book")]
        if files:
            L += ["", bold("Files:")]
            for f in files:
                L.append(f"  {(f.get('filepath') or '/').lstrip('/')}{f['filename']}  {dim(human(f.get('filesize')))}  "
                         f"{dim(fmt_time(f.get('timemodified')))}")
            if hints and mod in self.modules:
                L.append(dim(f"\n  download with: get {self.modules.index(mod) + 1}"))
        if kind not in ("resource", "folder", "page", "book", "url", "label"):
            L += ["", dim("web: " + mod.get("url", ""))]
